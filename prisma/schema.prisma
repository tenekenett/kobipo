// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Serverless (Vercel): use Transaction pooler :6543 + ?pgbouncer=true (IPv4-friendly).
  // Migrations / db push: set DIRECT_URL to Session pooler or Direct (see CONNECTION_FIX.md).
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Kullanıcı rolleri
enum Role {
  ADMIN       // Firma yöneticisi - tam yetki
  ACCOUNTANT  // Muhasebeci
  STOCK       // Stokçu
  SALES       // Satış
  VIEWER      // Görüntüleyici - sadece okuma
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  companyDisplayName String?
  phone         String?
  password      String
  emailVerified DateTime?
  image         String?
  isSuperAdmin  Boolean   @default(false) // Sistem yöneticisi
  twoFactorSecret String?
  twoFactorEnabled Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  companies     UserCompany[]
  accounts      Account[]
  sessions      Session[]
  systemLogs    SystemLog[]
  subscriptions Subscription[]
  supportTickets SupportTicket[] @relation("SupportTicketCreatedBy")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Company {
  id          String   @id @default(cuid())
  name        String
  taxNumber   String?  @unique
  taxOffice   String?
  address     String?  @db.Text
  city        String?
  country     String   @default("TR")
  phone       String?
  email       String?
  website     String?
  isEDonusumEnabled Boolean @default(false)
  invoiceSeriesPrefix String?
  isActive    Boolean  @default(true) // Firma aktif/pasif durumu
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserCompany[]
  customers   Customer[]
  suppliers   Supplier[]
  products    Product[]
  financialAccounts FinancialAccount[]
  transactions Transaction[]
  invoices    Invoice[]
  quotes      Quote[]
  paymentLinks PaymentLink[]
  stockMovements StockMovement[]
  invoicePayments InvoicePayment[]
  checks      Check[]
  promissoryNotes PromissoryNote[]
  warehouses  Warehouse[]
  accountPlans AccountPlan[]
  accountingEntries AccountingEntry[]
  waybills    Waybill[]
  bankStatements BankStatement[]
  cashCounts  CashCount[]
  subscriptions Subscription[]
  usageLimits UsageLimit[]
  notifications Notification[]
  attachments Attachment[]
  supportTickets SupportTicket[]

  @@map("companies")
}

model UserCompany {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      Role     @default(VIEWER) // Varsayılan: görüntüleyici
  invitedBy String?
  invitedAt DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@map("user_companies")
}

model Customer {
  id          String   @id @default(cuid())
  companyId   String
  code        String?
  name        String
  taxNumber   String?
  taxOffice   String?
  address     String?  @db.Text
  city        String?
  country     String   @default("TR")
  phone       String?
  email       String?
  contactPerson String?
  paymentDueDays Int?
  isAlsoSupplier Boolean @default(false)
  linkedSupplierId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  linkedSupplier Supplier? @relation("CustomerSupplierLink", fields: [linkedSupplierId], references: [id], onDelete: SetNull)
  invoices    Invoice[]
  quotes      Quote[]
  transactions Transaction[]
  checks      Check[]
  promissoryNotes PromissoryNote[]
  waybills    Waybill[]

  @@unique([linkedSupplierId])
  @@map("customers")
}

model Supplier {
  id          String   @id @default(cuid())
  companyId   String
  code        String?
  name        String
  taxNumber   String?
  taxOffice   String?
  address     String?  @db.Text
  city        String?
  country     String   @default("TR")
  phone       String?
  email       String?
  contactPerson String?
  paymentDueDays Int?
  isAlsoCustomer Boolean @default(false)
  linkedCustomerId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  linkedCustomers Customer[] @relation("CustomerSupplierLink")
  invoices    Invoice[]
  quotes      Quote[]
  transactions Transaction[]
  checks      Check[]
  promissoryNotes PromissoryNote[]
  waybills    Waybill[]

  @@map("suppliers")
}

model Product {
  id          String   @id @default(cuid())
  companyId   String
  code        String?
  name        String
  barcode     String?
  unit        String   @default("ADET")
  vatRate     Decimal  @default(20) @db.Decimal(5, 2)
  purchasePrice Decimal? @db.Decimal(10, 2)
  salePrice   Decimal? @db.Decimal(10, 2)
  stockQuantity Decimal @default(0) @db.Decimal(10, 2)
  minStockLevel Decimal? @db.Decimal(10, 2)
  isService   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
  invoiceItems InvoiceItem[]
  quoteItems  QuoteItem[]
  warehouseStocks WarehouseStock[]
  waybillItems WaybillItem[]

  @@map("products")
}

model StockMovement {
  id          String   @id @default(cuid())
  companyId   String
  productId   String
  warehouseId String?  // Depo ID (opsiyonel, geriye dönük uyumluluk için)
  type        String   // IN, OUT, TRANSFER, ADJUSTMENT
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal? @db.Decimal(10, 2)
  description String?  @db.Text
  reference   String?  // Invoice ID, etc.
  createdAt   DateTime @default(now())
  createdBy   String?

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@index([warehouseId])
  @@map("stock_movements")
}

model Warehouse {
  id          String   @id @default(cuid())
  companyId   String
  code        String?
  name        String
  address     String?  @db.Text
  city        String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stocks      WarehouseStock[]
  stockMovements StockMovement[]

  @@index([companyId])
  @@map("warehouses")
}

model WarehouseStock {
  id          String   @id @default(cuid())
  warehouseId String
  productId   String
  quantity    Decimal  @default(0) @db.Decimal(10, 2)
  updatedAt   DateTime @updatedAt

  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
  @@index([warehouseId])
  @@index([productId])
  @@map("warehouse_stocks")
}

model FinancialAccount {
  id          String   @id @default(cuid())
  companyId   String
  code        String?
  name        String
  type        String   // CASH, BANK
  bankName    String?
  accountNumber String?
  iban        String?
  currency    String   @default("TRY")
  balance     Decimal  @default(0) @db.Decimal(15, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  invoicePayments InvoicePayment[]
  bankStatements BankStatement[]
  cashCounts CashCount[]

  @@map("financial_accounts")
}

model BankStatement {
  id          String   @id @default(cuid())
  companyId   String
  accountId   String
  statementDate DateTime
  openingBalance Decimal @db.Decimal(15, 2)
  closingBalance Decimal @db.Decimal(15, 2)
  isReconciled Boolean @default(false)
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account     FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  items       BankStatementItem[]

  @@index([companyId])
  @@index([accountId])
  @@index([statementDate])
  @@map("bank_statements")
}

model BankStatementItem {
  id          String   @id @default(cuid())
  statementId String
  transactionDate DateTime
  valueDate   DateTime?
  description String
  amount      Decimal  @db.Decimal(15, 2) // Pozitif: gelir, Negatif: gider
  balance     Decimal? @db.Decimal(15, 2) // Bakiye
  reference   String?  // Referans no
  isMatched   Boolean  @default(false) // Eşleştirildi mi?
  matchedTransactionId String? // Eşleşen Transaction ID
  notes       String?  @db.Text
  order       Int      @default(0)

  statement   BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@index([statementId])
  @@index([isMatched])
  @@map("bank_statement_items")
}

model CashCount {
  id          String   @id @default(cuid())
  companyId   String
  accountId   String   // FinancialAccount ID (CASH type)
  countDate   DateTime @default(now())
  expectedBalance Decimal @db.Decimal(15, 2) // Beklenen bakiye
  actualBalance Decimal @db.Decimal(15, 2) // Sayılan bakiye
  difference  Decimal  @db.Decimal(15, 2) // Fark
  notes       String?  @db.Text
  isApproved  Boolean  @default(false)
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account     FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([accountId])
  @@index([countDate])
  @@map("cash_counts")
}

model Transaction {
  id          String   @id @default(cuid())
  companyId   String
  accountId   String
  type        String   // INCOME, EXPENSE, TRANSFER
  amount      Decimal  @db.Decimal(15, 2)
  currency    String   @default("TRY")
  description String?  @db.Text
  date        DateTime @default(now())
  reference   String?
  customerId  String?
  supplierId  String?
  createdAt   DateTime @default(now())
  createdBy   String?

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account     FinancialAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@map("transactions")
}

model Invoice {
  id          String   @id @default(cuid())
  companyId   String
  invoiceNo   String
  type        String   // SALES, PURCHASE
  invoiceType String   // E_INVOICE, E_ARCHIVE
  status      String   @default("DRAFT") // DRAFT, SENT, CANCELLED
  customerId  String?
  supplierId  String?
  date        DateTime @default(now())
  dueDate     DateTime?
  totalAmount Decimal  @db.Decimal(15, 2)
  vatAmount   Decimal  @db.Decimal(15, 2)
  netAmount   Decimal  @db.Decimal(15, 2)
  currency    String   @default("TRY")
  exchangeRate Decimal? @db.Decimal(12, 4)
  exchangeRateDate DateTime?
  uuid        String?  @unique // E-Fatura UUID
  integrationId String? // Entegratör ID
  integrationStatus String? // Entegratör durumu
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items       InvoiceItem[]
  payments    InvoicePayment[]
  paymentLinks PaymentLink[]
  convertedFromQuotes Quote[]
  waybills    Waybill[]

  @@unique([companyId, invoiceNo])
  @@map("invoices")
}

model Quote {
  id          String   @id @default(cuid())
  companyId   String
  quoteNo     String
  status      String   @default("DRAFT") // DRAFT, SENT, APPROVED, REJECTED, EXPIRED, CONVERTED
  customerId  String?
  supplierId  String?
  date        DateTime @default(now())
  validUntil  DateTime?
  totalAmount Decimal  @db.Decimal(15, 2)
  vatAmount   Decimal  @db.Decimal(15, 2)
  netAmount   Decimal  @db.Decimal(15, 2)
  currency    String   @default("TRY")
  notes       String?  @db.Text
  convertedInvoiceId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  convertedInvoice Invoice? @relation(fields: [convertedInvoiceId], references: [id], onDelete: SetNull)
  items       QuoteItem[]

  @@unique([companyId, quoteNo])
  @@index([companyId])
  @@index([date])
  @@index([status])
  @@map("quotes")
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String
  productId   String?
  description String
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(10, 2)
  discountRate Decimal? @db.Decimal(5, 2)
  discountAmount Decimal? @db.Decimal(10, 2)
  vatRate     Decimal  @db.Decimal(5, 2)
  vatAmount   Decimal  @db.Decimal(10, 2)
  totalAmount Decimal  @db.Decimal(10, 2)
  order       Int      @default(0)

  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("quote_items")
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  productId   String?
  description String
  unit        String   @default("ADET")
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(10, 2)
  discountRate Decimal? @db.Decimal(5, 2)
  discountAmount Decimal? @db.Decimal(10, 2)
  vatRate     Decimal  @db.Decimal(5, 2)
  vatAmount   Decimal  @db.Decimal(10, 2)
  withholdingRate Decimal? @db.Decimal(5, 2)
  withholdingAmount Decimal? @db.Decimal(10, 2)
  exciseRate Decimal? @db.Decimal(5, 2)
  exciseAmount Decimal? @db.Decimal(10, 2)
  totalAmount Decimal  @db.Decimal(10, 2)
  order       Int      @default(0)

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("invoice_items")
}

model InvoicePayment {
  id          String   @id @default(cuid())
  invoiceId   String
  companyId   String
  amount      Decimal  @db.Decimal(15, 2)
  paymentDate DateTime @default(now())
  paymentMethod String  // CASH, BANK_TRANSFER, CHECK, CREDIT_CARD, OTHER
  accountId   String?  // FinancialAccount ID
  reference   String?  // Ödeme referansı (makbuz no, işlem no vb.)
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  createdBy   String?

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account     FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([companyId])
  @@index([paymentDate])
  @@map("invoice_payments")
}

model PaymentLink {
  id          String   @id @default(cuid())
  companyId   String
  invoiceId   String
  token       String   @unique
  amount      Decimal  @db.Decimal(15, 2)
  currency    String   @default("TRY")
  status      String   @default("ACTIVE") // ACTIVE, PAID, EXPIRED, CANCELLED
  expiresAt   DateTime?
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  createdBy   String?

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([invoiceId])
  @@map("payment_links")
}

model Waybill {
  id          String   @id @default(cuid())
  companyId   String
  waybillNo   String
  type        String   // SALES, PURCHASE
  status      String   @default("DRAFT") // DRAFT, SENT, DELIVERED, CANCELLED
  customerId  String?
  supplierId  String?
  invoiceId   String?  // İlgili fatura
  date        DateTime @default(now())
  deliveryDate DateTime?
  carrier     String?  // Taşıyıcı firma
  vehicleNo   String?  // Araç plakası
  driverName  String?  // Şoför adı
  departureAddress String? @db.Text
  deliveryAddress   String? @db.Text
  notes       String?  @db.Text
  uuid        String?  @unique // E-İrsaliye UUID
  integrationId String? // Entegratör ID
  integrationStatus String? // Entegratör durumu
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  items       WaybillItem[]

  @@unique([companyId, waybillNo])
  @@index([companyId])
  @@index([date])
  @@index([status])
  @@map("waybills")
}

model WaybillItem {
  id          String   @id @default(cuid())
  waybillId   String
  productId   String?
  description String
  quantity    Decimal  @db.Decimal(10, 2)
  unit        String?  // Adet, Kg, m², vb.
  weight      Decimal? @db.Decimal(10, 2) // Ağırlık (kg)
  notes       String?  @db.Text
  order       Int      @default(0)

  waybill     Waybill  @relation(fields: [waybillId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("waybill_items")
}

model Check {
  id          String   @id @default(cuid())
  companyId   String
  checkNo     String
  bankName    String
  branchName  String?
  accountNo   String?
  amount      Decimal  @db.Decimal(15, 2)
  issueDate   DateTime
  dueDate     DateTime
  status      String   @default("PORTFÖYDE") // PORTFÖYDE, CİRO_EDİLDİ, TAHSİL_EDİLDİ, İADE_EDİLDİ, PROTESTOLU
  customerId  String?
  supplierId  String?
  invoiceId   String?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([dueDate])
  @@index([status])
  @@map("checks")
}

model PromissoryNote {
  id          String   @id @default(cuid())
  companyId   String
  noteNo      String
  amount      Decimal  @db.Decimal(15, 2)
  issueDate   DateTime
  dueDate     DateTime
  status      String   @default("PORTFÖYDE") // PORTFÖYDE, CİRO_EDİLDİ, TAHSİL_EDİLDİ, İADE_EDİLDİ, PROTESTOLU
  customerId  String?
  supplierId  String?
  invoiceId   String?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([dueDate])
  @@index([status])
  @@map("promissory_notes")
}

model AccountPlan {
  id          String   @id @default(cuid())
  companyId   String
  code        String
  name        String
  parentId    String?  // Üst hesap
  type        String   // ASSET, LIABILITY, EQUITY, INCOME, EXPENSE
  level       Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent      AccountPlan? @relation("AccountPlanHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    AccountPlan[] @relation("AccountPlanHierarchy")
  debitEntries AccountingEntry[] @relation("DebitEntries")
  creditEntries AccountingEntry[] @relation("CreditEntries")

  @@unique([companyId, code])
  @@index([companyId])
  @@index([parentId])
  @@map("account_plans")
}

model AccountingEntry {
  id          String   @id @default(cuid())
  companyId   String
  entryNo     String
  date        DateTime @default(now())
  description String?  @db.Text
  debitAccountId  String
  creditAccountId String
  amount      Decimal  @db.Decimal(15, 2)
  reference   String?  // Invoice ID, Transaction ID, etc.
  referenceType String? // INVOICE, TRANSACTION, MANUAL, etc.
  createdAt   DateTime @default(now())
  createdBy   String?

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  debitAccount AccountPlan @relation("DebitEntries", fields: [debitAccountId], references: [id], onDelete: Restrict)
  creditAccount AccountPlan @relation("CreditEntries", fields: [creditAccountId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([date])
  @@index([debitAccountId])
  @@index([creditAccountId])
  @@map("accounting_entries")
}

// Sistem logları - Super Admin için
model SystemLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String   // LOGIN, LOGOUT, CREATE, UPDATE, DELETE, ERROR
  entity      String?  // User, Company, Invoice, etc.
  entityId    String?
  details     String?  @db.Text
  ipAddress   String?
  userAgent   String?  @db.Text
  level       String   @default("INFO") // INFO, WARN, ERROR
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@index([action])
  @@map("system_logs")
}

model Plan {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  monthlyPrice Decimal @default(0) @db.Decimal(10, 2)
  yearlyPrice  Decimal? @db.Decimal(10, 2)
  maxCompanies Int      @default(1)
  maxUsers     Int      @default(1)
  maxInvoicesPerMonth Int @default(100)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id          String   @id @default(cuid())
  userId      String
  companyId   String
  planId      String
  provider    String   @default("NONE")
  providerSubscriptionId String?
  status      String   @default("TRIAL")
  trialEndsAt DateTime?
  periodStart DateTime?
  periodEnd   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan        Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@map("subscriptions")
}

model UsageLimit {
  id          String   @id @default(cuid())
  companyId   String
  key         String
  currentValue Int     @default(0)
  maxValue    Int
  periodStart DateTime
  periodEnd   DateTime
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key, periodStart])
  @@map("usage_limits")
}

model Notification {
  id          String   @id @default(cuid())
  companyId   String
  title       String
  message     String
  type        String   @default("INFO")
  isRead      Boolean  @default(false)
  link        String?
  createdAt   DateTime @default(now())

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, isRead])
  @@map("notifications")
}

model Attachment {
  id          String   @id @default(cuid())
  companyId   String
  entityType  String
  entityId    String
  fileName    String
  filePath    String
  mimeType    String?
  sizeBytes   Int?
  createdAt   DateTime @default(now())
  createdBy   String?

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, entityType, entityId])
  @@map("attachments")
}

model SupportTicket {
  id          String   @id @default(cuid())
  companyId   String
  subject     String
  message     String   @db.Text
  status      String   @default("OPEN")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("SupportTicketCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@map("support_tickets")
}

