model InvoiceItem {
  id                     String   @id @default(cuid())
  invoiceId              String
  productId              String?
  description            String
  // Satır açıklaması: mal/hizmet ADININ (description) altına basılan serbest
  // metin. Mysoft'a invoiceDetail.note olarak gider (UBL kalem notu) — açıklamayı
  // description'a yazmak GİB belgesinde ürün adını kirletir. Tekliften faturaya
  // dönüşümde QuoteItem.note buraya taşınır.
  note                   String?  @db.Text
  unit                   String   @default("ADET")
  quantity               Decimal  @db.Decimal(10, 2)
  unitPrice              Decimal  @db.Decimal(15, 6) // 6 ondalık: UBL e-Fatura birim fiyat hassasiyeti
  discountRate           Decimal? @db.Decimal(5, 2)
  discountAmount         Decimal? @db.Decimal(10, 2)
  vatRate                Decimal  @db.Decimal(5, 2)
  vatAmount              Decimal  @db.Decimal(10, 2)
  // KDV tevkifatı. withholdingRate = tevkif edilen KDV yüzdesi (GİB oranı, ör. 50).
  // withholdingAmount = vatAmount * withholdingRate / 100. withholdingCode = GİB
  // tevkifat kodu (ör. "604"); kullanıcı hazır kod listesinden seçer.
  withholdingCode        String?  @db.VarChar(10)
  withholdingName        String?  @db.VarChar(255)
  withholdingRate        Decimal? @db.Decimal(5, 2)
  withholdingAmount      Decimal? @db.Decimal(10, 2)
  // ÖTV. exciseRate = oran (%), exciseAmount = net * exciseRate / 100. exciseCode =
  // GİB ÖTV vergi türü kodu (liste-bazlı: 0071 I. Liste / 0073 III. Liste /
  // 0074 IV. Liste ...). GİB payload'ında tax[].taxCode olarak gönderilir.
  exciseRate             Decimal? @db.Decimal(5, 2)
  exciseCode             String?  @db.VarChar(10)
  exciseAmount           Decimal? @db.Decimal(10, 2)
  // KDV/ÖTV dışı "Diğer Vergiler" (ör. Konaklama Vergisi). Matrahın üzerine eklenir.
  // otherTaxAmount = net * otherTaxRate / 100. otherTaxName = verginin adı (ör. "Konaklama Vergisi").
  // otherTaxCode = GİB vergi türü kodu (0059 Konaklama / 4071 Elektrik / 4080 ÖİV).
  // GİB payload'ında tax[].taxCode olarak ZORUNLU — kod olmadan GİB şematronu reddeder.
  otherTaxName           String?  @db.VarChar(255)
  otherTaxCode           String?  @db.VarChar(10)
  otherTaxRate           Decimal? @db.Decimal(5, 2)
  otherTaxAmount         Decimal? @db.Decimal(10, 2)
  // GEKAP (Geri Kazanım Katılım Payı) — MAKTU'dur: birim başına sabit tutar,
  // oran DEĞİL. gekapAmount = quantity * gekapUnitAmount; satır iskontosundan da
  // fatura altı iskontodan da ETKİLENMEZ (miktara bağlı sabit çevre payı).
  // KDV matrahına dahildir (KDVK 24/b) — bkz. lib/invoice/line-tax.ts.
  // UBL-TR vergi kodları listesinde karşılığı YOK → GİB'e satır masrafı
  // (cac:AllowanceCharge, chargeIndicator=true) olarak gider.
  gekapUnitAmount        Decimal? @db.Decimal(15, 6)
  gekapAmount            Decimal? @db.Decimal(10, 2)
  totalAmount            Decimal  @db.Decimal(10, 2)
  taxExemptionReasonCode String?  @db.VarChar(10)
  taxExemptionReason     String?  @db.VarChar(255)
  order                  Int      @default(0)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_items")
}

model InvoicePayment {
  id            String   @id @default(cuid())
  invoiceId     String
  companyId     String
  amount        Decimal  @db.Decimal(15, 2)
  paymentDate   DateTime @default(now())
  paymentMethod String // CASH, BANK_TRANSFER, CHECK, CREDIT_CARD, OTHER
