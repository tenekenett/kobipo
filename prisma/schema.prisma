// Sistem logları - Super Admin için
model SystemLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String // LOGIN, LOGOUT, CREATE, UPDATE, DELETE, ERROR
  entity    String? // User, Company, Invoice, etc.
  entityId  String?
  details   String?  @db.Text
  ipAddress String?
  userAgent String?  @db.Text
  level     String   @default("INFO") // INFO, WARN, ERROR
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@index([action])
  @@map("system_logs")
}

/// ERİŞİM (trafik) kaydı — kim, ne zaman, hangi IP'den giriş yaptı/denedi.
///
/// NEDEN AYRI TABLO: `SystemLog` yönetici işlemlerinin karışık günlüğüdür (firma
/// güncellendi, kontör yüklendi…) ve ekranda son 100 satır gösterilir. Erişim kaydı ise
/// hukuki bir defterdir: IP + zaman ile SORGULANABİLİR olmalı, silinmemeli ve
/// başka kayıtların gürültüsüne karışmamalı. İndeksler o sorguya göre: "şu IP'den kim
/// girdi", "şu kullanıcı ne zaman girdi", "şu tarih aralığında ne oldu".
///
/// PORT: NAT arkasındaki bir istemciyi tek başına IP ayırt etmez, kaynak portu gerekir.
/// Ama port ancak vekil sunucu iletirse elimize geçer (bkz. lib/audit/access-log.ts) —
/// iletilmiyorsa null kalır, uydurulmaz.
model AccessLog {
  id           String   @id @default(cuid())
  /// Kullanıcı silinse bile kayıt kalır (SetNull): defterin amacı geçmişi korumaktır.
  userId       String?
  /// Denemede girilen e-posta. Kullanıcı bulunamayan başarısız girişlerde tek ipucu budur.
  email        String?
  /// LOGIN | LOGIN_FAILED | LOGOUT | SIGNUP | PASSWORD_RESET_REQUEST | PASSWORD_RESET
  action       String
  /// Başarısızlık sebebi (hatalı şifre, kilitli IP, captcha…). Başarıda null.
  reason       String?
  ip           String?
  port         Int?
  /// Vekil zincirinin tamamı (`x-forwarded-for`). Tek IP yanıltıcı olabilir.
  forwardedFor String?  @db.Text
  userAgent    String?  @db.Text
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@index([ip])
  @@index([action])
  @@index([email])
  @@map("access_logs")
}

// Platform geneli ayarlar (key-value). Sistem yönetimi > Ayarlar sayfası tarafından kullanılır.
model SystemSetting {
  key       String   @id
  value     String?  @db.Text
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// Satılabilir hazır paket (bundle). Deneme planı (FREE_1Y) da bu tabloda tutulur.
// Hibrit fiyatlandırmada müşteri bir bundle seçip üzerine tekil modül/şube ekleyebilir
// (à la carte fiyatlar PricingItem tablosunda). Fiyatlar admin panelinden belirlenir.
model Plan {
  id                  String   @id @default(cuid())
  code                String   @unique
  name                String
  description         String?  @db.Text
  monthlyPrice        Decimal  @default(0) @db.Decimal(10, 2)
  yearlyPrice         Decimal? @db.Decimal(10, 2)
  // Paketin KDV oranı. NULL = KOBIPO_DEFAULT_VAT_RATE (%20). Fiyatlar KDV DAHİL'dir
  // (bkz. KontorPackage.vatRate); à la carte PricingItem'lar sabit orana tabidir.
  vatRate             Decimal? @db.Decimal(5, 2)
  // Paketin içerdiği modül anahtarları (MANAGEABLE_MODULES.key). Boş = temel/deneme paketi.
  includedModules     String[] @default([])
  // Pakete dahil ek şube sayısı (ana firma hariç). Ek şubeler bunun üstünde PricingItem[branch] ile.
  includedBranches    Int      @default(0)
  // Pakete dahil ek FİRMA sayısı (hesabın kök firması hariç). Ek firma = ayrı VKN'li
  // tüzel kişi, aynı abonelik. Şube kotasından bağımsızdır; üstü PricingItem[company].
  includedCompanies   Int      @default(0)
  maxUsers            Int      @default(1)
  maxInvoicesPerMonth Int      @default(100)
  highlighted         Boolean  @default(false) // Müşteri ekranında "Önerilen" rozeti
  sortOrder           Int      @default(0)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  subscriptions Subscription[]
  packageOrders PackageOrder[]

  @@map("plans")
}

// À la carte tekil fiyatlar (admin panelinden yönetilir). key örnekleri:
//   "module:sales", "module:purchase", ... (her MANAGEABLE_MODULES anahtarı)
//   "branch" (ek şube kotası birim fiyatı)
model PricingItem {
  key          String   @id
  label        String
  monthlyPrice Decimal  @default(0) @db.Decimal(10, 2)
  yearlyPrice  Decimal  @default(0) @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@map("pricing_items")
}

// Bir hesabın (kök/ana firma) aktif aboneliği. Hibrit + à la carte alımda tek bir
// bundle olmayabileceğinden planId opsiyoneldir; efektif haklar snapshot olarak tutulur.
model Subscription {
  id                     String    @id @default(cuid())
  userId                 String
  companyId              String
  planId                 String? // Seçilen bundle (varsa). Tam custom alımda null.
  provider               String    @default("NONE") // NONE | PAYTR
  providerSubscriptionId String? // PayTR recurring token (yinelenen ödeme)
  status                 String    @default("TRIAL") // TRIAL | ACTIVE | PAST_DUE | CANCELLED | EXPIRED
  billingCycle           String? // MONTHLY | YEARLY
  // Efektif açık modül anahtarları (snapshot). TRIAL'da boş bırakılır (hepsi açık kabul edilir).
  purchasedModules       String[]  @default([])
  branchQuota            Int       @default(0) // hesap genelinde izin verilen ek şube sayısı
  companyQuota           Int       @default(0) // kök firma hariç izin verilen ek firma (ayrı VKN) sayısı
  amount                 Decimal?  @db.Decimal(10, 2) // dönem tutarı (snapshot)
  autoRenew              Boolean   @default(false)
  cancelAtPeriodEnd      Boolean   @default(false)
  paymentRef             String?
  trialEndsAt            DateTime?
  periodStart            DateTime?
  periodEnd              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan?   @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@map("subscriptions")
}

// Müşterinin paket/abonelik satın alma siparişi. Ödeme PayTR üzerinden asenkron
// alındığından seçim önce burada tutulur; başarılı callback'te Subscription'a yansır.
// id = PayTR merchant_oid (kontör deseniyle aynı).
model PackageOrder {
  id               String             @id @default(cuid())
  companyId        String
  planId           String? // seçilen bundle (varsa)
  planName         String? // snapshot
  selectedModules  String[]           @default([]) // bundle dışı ekstra seçilen modüller
  resolvedModules  String[]           @default([]) // nihai açılacak modül seti (snapshot)
  branchQuota      Int                @default(0) // satın alınan ek şube kotası
  companyQuota     Int                @default(0) // satın alınan ek firma kotası
  billingCycle     String // MONTHLY | YEARLY
  // amount = TAHSİL EDİLEN tutar (indirim düşülmüş); liste tutarı
  // `amount + discountAmount`tır. Yenilemede hangi tutarın çekileceğini
  // `DiscountCode.appliesToRenewals` belirler. [[DiscountCode]]
  amount           Decimal            @db.Decimal(10, 2)
  discountCodeId   String?
  discountCode     String? // sipariş anı snapshot'ı
  discountAmount   Decimal            @default(0) @db.Decimal(10, 2)
  currency         String             @default("TRY")
  autoRenew        Boolean            @default(true)
  status           PackageOrderStatus @default(PENDING_PAYMENT)
  // PayTR sanal POS alanları. merchant_oid = order.id (ayrı alan yok).
  paymentProvider  String? // "PAYTR"
  paidAt           DateTime? // ödeme onay bildirimi (callback) anı
  paymentRef       String? // PayTR referansı / echo
  paymentError     String?            @db.Text // başarısız ödeme nedeni
  recurringToken   String? // PayTR recurring (kart) token'ı, varsa
  // OTOMATİK FATURALANDIRMA — alanların anlamı [[KontorOrder]] ile birebir aynıdır.
  invoiceId        String?            @unique
  invoicedAt       DateTime?
  invoiceError     String?            @db.Text
  invoiceAttempts  Int                @default(0)
  isTest           Boolean            @default(false)
  billingName      String?
  billingTaxNumber String?
  billingTaxOffice String?
  billingAddress   String?            @db.Text
  billingCity      String?
  billingDistrict  String?
  billingEmail     String?
  createdById      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan?    @relation(fields: [planId], references: [id], onDelete: SetNull)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([status])
  @@map("package_orders")
}

model UsageLimit {
  id           String   @id @default(cuid())
  companyId    String
  key          String
  currentValue Int      @default(0)
  maxValue     Int
  periodStart  DateTime
  periodEnd    DateTime
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key, periodStart])
  @@map("usage_limits")
}

// Kobipo'nun sattığı kontör paketleri (sistem-admin tanımlar).
// Müşteri fiyatı Kobipo'ya aittir; mysoftTariffCode ise yüklemede (insertDocumentCredit) kullanılır.
model KontorPackage {
  id               String   @id @default(cuid())
  name             String // "1000 E-Belge"
  description      String?
  creditQty        Int // yüklenecek kontör adedi
  price            Decimal  @db.Decimal(10, 2) // Kobipo müşteri fiyatı — KDV DAHİL
  currency         String   @default("TRY")
  // Bu paketin KDV oranı. NULL = KOBIPO_DEFAULT_VAT_RATE (%20). Fiyat KDV DAHİL
  // tutulur (KOBIPO_PRICES_INCLUDE_VAT): müşteri ne ödüyorsa faturanın ödenecek
  // tutarı odur, matrah/KDV iç yüzdeyle ayrıştırılır. Bkz. lib/billing/vat.ts.
  vatRate          Decimal? @db.Decimal(5, 2)
  mysoftTariffCode String // Mysoft İş Ortağı tarife kodu (getBusinessPartnerTariff)
  validityMonths   Int? // expiryDate hesabı; boşsa tarife default'u
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orders KontorOrder[]

  @@map("kontor_packages")
}

// Müşterinin kontör satın alma siparişi. Havale + sistem-admin onayı ile ilerler;
// onaylanınca bayi kimliğiyle Mysoft'a insertDocumentCredit yapılır.
model KontorOrder {
  id                String            @id @default(cuid())
  companyId         String
  packageId         String?
  // Sipariş anı snapshot'ı (paket sonradan değişse/silinse bile sabit kalır)
  packageName       String
  creditQty         Int
  unitPrice         Decimal           @db.Decimal(10, 2)
  // totalPrice = TAHSİL EDİLEN tutar (indirim düşülmüş). Liste tutarı
  // `totalPrice + discountAmount`tır; fatura kalemi liste fiyatından yazılıp
  // iskonto ayrı satır olarak işlenir. [[DiscountCode]]
  totalPrice        Decimal           @db.Decimal(10, 2)
  discountCodeId    String?
  discountCode      String? // sipariş anı snapshot'ı (kod sonradan silinse de kalır)
  discountAmount    Decimal           @default(0) @db.Decimal(10, 2)
  currency          String            @default("TRY")
  mysoftTariffCode  String
  targetVkn         String // kontörün yükleneceği mükellef VKN/TCKN
  status            KontorOrderStatus @default(PENDING_PAYMENT)
  paymentMethod     String            @default("HAVALE") // HAVALE | CARD
  receiptUrl        String? // dekont harici bağlantı (dosya yüklenmediyse)
  // Havale akışı: müşteriye kod verilir → açıklamaya yazıp parayı gönderir →
  // dekontu yükler → sistem-admin panelinde görür ve onaylar.
  paymentCode       String?           @unique // havale açıklamasına yazılacak kod (KBP-XXXXXX)
  paymentNote       String?           @db.Text // müşterinin beyanı (gönderen ad, tarih…)
  receiptFileName   String?
  receiptMimeType   String?
  receiptFileSize   Int? // bayt
  receiptUploadedAt DateTime?
  // Sanal POS (PayTR) ödeme alanları. merchant_oid = order.id (ayrı alan yok).
  paymentProvider   String? // "PAYTR" (kart ödemesinde)
  paidAt            DateTime? // ödeme onay bildirimi (callback) anı
  paymentRef        String? // PayTR referansı / echo
  paymentError      String?           @db.Text // başarısız ödeme nedeni
  // Mysoft yükleme sonucu
  mysoftCreditId    String?
  loadError         String?           @db.Text
  // OTOMATİK FATURALANDIRMA (docs/faturalandirma/PLAN.md).
  // Fatura satıcı firmada (Kobipo'nun tüzel kişisi) açılır, alıcı firmada DEĞİL.
  // invoiceId @unique = çift fatura kilidi: servis `invoiceId: null` koşuluyla
  // claim eder, ikinci callback count=0 alıp çıkar.
  invoiceId         String?           @unique
  invoicedAt        DateTime?
  invoiceError      String?           @db.Text
  invoiceAttempts   Int               @default(0)
  // Sipariş anındaki test damgası. Kart siparişinde PAYTR_TEST_MODE="1" ise true:
  // PayTR test ödemesinde para ÇEKİLMEZ ama callback success döner, kontör gerçekten
  // yüklenir. Karşılığı tahsil edilmemiş bir satış için GİB'e gerçek belge gitmesin
  // diye fatura kesilmez. Env sonradan değişse geçmiş siparişler etkilenmesin diye
  // bayrak sipariş anında SNAPSHOT'lanır.
  isTest            Boolean           @default(false)
  // Fatura bilgisi snapshot'ı: satın alma anında toplanır. Firma kartı sonradan
  // değişse de belge, satışın yapıldığı andaki ünvan/VKN/adresle uyumlu kalır.
  billingName       String?
  billingTaxNumber  String?
  billingTaxOffice  String?
  billingAddress    String?           @db.Text
  billingCity       String?
  billingDistrict   String?
  billingEmail      String?
  // İz kayıtları
  createdById       String?
  confirmedById     String?
  confirmedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  company Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  package KontorPackage?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
  receipt KontorOrderReceipt?
  invoice Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([status])
  @@map("kontor_orders")
}

/// Dekont dosyasının baytları. Ayrı tabloda çünkü sipariş listeleri (müşteri kartı,
/// sistem-admin tablosu) her satırda MB'lık blob taşımamalı — personel belgeleri
/// deseninin aynısı ([[EmployeeDocumentBlob]]). Dekont özel veridir; public bucket'a
/// değil DB'ye yazılır, indirme ucu yetki kontrolüyle servis eder.
model KontorOrderReceipt {
  id        String   @id @default(cuid())
  orderId   String   @unique
  data      Bytes
  createdAt DateTime @default(now())

  order KontorOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("kontor_order_receipts")
}

model Notification {
  id        String   @id @default(cuid())
  companyId String
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, isRead])
  @@map("notifications")
}

model Attachment {
  id         String   @id @default(cuid())
  companyId  String
  entityType String
  entityId   String
  fileName   String
  filePath   String
  mimeType   String?
  sizeBytes  Int?
  createdAt  DateTime @default(now())
  createdBy  String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, entityType, entityId])
  @@map("attachments")
}

model SupportTicket {
  id            String   @id @default(cuid())
  companyId     String
  subject       String
  message       String   @db.Text
  // Durum: OPEN (yeni), ANSWERED (admin yanıtladı), CLOSED (kapatıldı)
  status        String   @default("OPEN")
  // Kullanıcı, destek ekibinin hesabında inceleme/değişiklik yapmasına izin verdi mi?
  // Talep oluştururken opt-in olarak işaretlenir; ekip bu izni görür.
  accessConsent Boolean  @default(false)
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company   Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User                   @relation("SupportTicketCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  messages  SupportTicketMessage[]

  @@index([companyId, status])
  @@index([status])
  @@map("support_tickets")
}

// Destek talebi konuşma mesajları (açılış mesajı SupportTicket.message'tadır;
// bu tablo sonraki karşılıklı yanıtları tutar). isAdmin=true → sistem-admin yanıtı.
model SupportTicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  isAdmin   Boolean  @default(false)
  body      String   @db.Text
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("support_ticket_messages")
}

// Mysoft InvoiceInbox'tan çekilen gelen e-faturalar. Her senkronizasyonda
// (uuid = Mysoft ETTN) firma bazında upsert edilir; rawJson alanı Mysoft
// yanıtının tamamını saklar (KDV oran dağılımı, zarf durumu, vs. raporlar için).
model IncomingInvoice {
  id                 String    @id @default(cuid())
  companyId          String
  uuid               String // Mysoft ETTN (firma içinde unique)
  invoiceNo          String?
  docDate            DateTime?
  senderTaxNumber    String?
  senderName         String?
  profile            String? // TEMELFATURA | TICARIFATURA
  invoiceType        String? // SATIS | TEVKIFAT | IADE | ISTISNA ...
  currencyCode       String? // TRY, USD, EUR
  currencyRate       Decimal?  @db.Decimal(18, 6)
  taxExclusiveAmount Decimal?  @db.Decimal(18, 2) // KDV hariç
  taxInclusiveAmount Decimal?  @db.Decimal(18, 2) // KDV dahil
  vatAmount          Decimal?  @db.Decimal(18, 2) // Toplam KDV (taxTotalTra)
  payableAmount      Decimal?  @db.Decimal(18, 2) // Ödenecek
  vatBreakdown       Json? // {0:0, 1:0, 8:0, 10:0, 18:0, 20:220, ...}
  status             String? // KABUL | RED | BEKLEMEDE ...
  envelopeStatusCode String?
  envelopeStatusDesc String?
  pkAlias            String?
  gbAlias            String?
  isArchived         Boolean   @default(false)
  // Kobipo iç akışı:
  isLinkedToPurchase Boolean   @default(false) // Alış faturasına dönüştürüldü mü
  linkedInvoiceId    String? // İlişkili Kobipo Invoice (alış) id'si
  raw                Json // Mysoft ham yanıtı (item objesi)
  syncedAt           DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, uuid])
  @@index([companyId, docDate])
  @@index([companyId, status])
  @@map("incoming_invoices")
}

// ---------------------------------------------------------------------------
// PERSONEL (İK) MODÜLÜ
// Alt kayıtlar (bordro/izin/zimmet/belge) companyId skaler alanıyla sorgulanır;
// firma silinince Employee (company relation, Cascade) ve ona bağlı alt kayıtlar
// (employee relation, Cascade) birlikte silinir. Bu yüzden alt modeller Company'ye
// ayrı bir relation TAŞIMAZ — yalnızca Employee'nin company relation'ı yeterli.
// ---------------------------------------------------------------------------

model Employee {
  id               String    @id @default(cuid())
  companyId        String
  // Bu personelin Kobipo hesabı (varsa). Personel kartı ile giriş yapan kullanıcı
  // AYRI şeylerdir ve öyle kalmalı: personel kartı olmayan ortak/muhasebeci hesap
  // alabilir, hesabı olmayan personel de bordroda durur. Bu alan yalnızca ikisini
  // EŞLEŞTİRİR — yetkinin kendisi UserCompany'de yaşar (allowedPaths).
  //
  // Kartın kullanışlı yanı: "bu çalışana hesap aç" kısayolu ve vardiya/ikram
  // tarafında kimin ne yaptığının hesapla birleşmesi.
  userId           String?
  firstName        String
  lastName         String
  slug             String    @default("")
  nationalId       String? // TC Kimlik No
  email            String?
  phone            String?
  birthDate        DateTime?
  department       String?
  position         String? // Görev / Unvan
  hireDate         DateTime?
  terminationDate  DateTime?
  grossSalary      Decimal?  @db.Decimal(12, 2)
  iban             String?
  address          String?   @db.Text
  emergencyContact String?
  annualLeaveDays  Int       @default(14) // Yıllık izin hakkı (gün)
  status           String    @default("ACTIVE") // ACTIVE, ON_LEAVE, TERMINATED
  notes            String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?

  company          Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // SET NULL: hesap silinse de personel kartı (bordro, izin, zimmet) ayakta kalır.
  user             User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  payrolls         PayrollRecord[]
  leaves           LeaveRecord[]
  assets           AssetAssignment[]
  documents        EmployeeDocument[]
  // Restoran modülünde bu personelin UYGULADIĞI hesap iskontoları. İK kartının
  // operasyona açılan ilk penceresi: bugüne kadar Employee ile satış tarafı
  // arasında hiçbir bağ yoktu (bkz. docs/restoran/PLAN.md "#7 vardiya/puantaj").
  ticketDiscounts  RestaurantTicket[]     @relation("TicketDiscountEmployee")
  // Bu personelin VERDİĞİ ikramlar. İki uçtan gelir ve ikisi de gerekli:
  // adisyonda kalem işaretlenirken (compItems), tezgâhta ise adisyon olmadığı
  // için doğrudan stok düzeltmesinde (compMovements).
  compItems        RestaurantTicketItem[] @relation("TicketItemCompEmployee")
  compMovements    StockMovement[]        @relation("StockMovementEmployee")
  shifts           WorkShift[]
  // Bu personel adına atılmış açılış/kapanış tikleri. Seçim listeden yapıldığı
  // için "bu maddeyi o yaptı" kanıtı değil, yalnız beyandır.
  checklistEntries ChecklistEntry[]

  // Bir hesap aynı firmada iki personel kartına bağlanamaz (kimin vardiyası, kimin
  // bordrosu sorusu belirsizleşirdi). Farklı firmalarda aynı hesap serbesttir.
  @@unique([companyId, userId])
  @@unique([companyId, slug])
  @@index([companyId])
  @@index([companyId, status])
  @@index([userId])
  @@map("employees")
}

// Bir personelin bir güne ait vardiyası.
//
// ZAMAN NEDEN Int DAKİKA? Bu projede saat dilimi bir kez pahalıya patladı:
// tarihler UTC saklanıyor, yerel gün çıplak gönderilince TSİ 00:00–03:00 arası
// kayıtlar yanlış güne düşüyordu (bkz. components/restoran/report-ui.tsx içindeki
// startIso/endIso notu). Gün (workDate, saatsiz) + gün başından itibaren dakika
// ikilisi bu sınıf hatayı tamamen ortadan kaldırır; 0–24 ızgarasında konum da
// doğrudan start/1440 oranıdır.
//
// GECE VARDİYASI: bitiş 1440'ı AŞABİLİR (22:00–02:00 → 1320–1560). "Bitiş
// başlangıçtan küçükse ertesi gündür" tahmini kasıtlı olarak kullanılmıyor —
// yanlış girilmiş saatle gece vardiyası ayırt edilemezdi.
//
// actualStart/actualEnd şimdilik YAZILMIYOR (v1 yalnız plan). Alanlar baştan
// duruyor ki fiilî giriş-çıkış fazı API sözleşmesini ve takvim bileşenini
// yeniden şekillendirmesin: bar çerçeve=plan, dolgu=fiilî çizilecek.
model WorkShift {
  id           String   @id @default(cuid())
  companyId    String
  employeeId   String
  workDate     DateTime @db.Date // vardiyanın ait olduğu iş günü (gece vardiyasında BAŞLADIĞI gün)
  plannedStart Int // gün başından dakika: 09:00 → 540
  plannedEnd   Int // 17:00 → 1020; gece vardiyasında > 1440 olabilir
  actualStart  Int?
  actualEnd    Int?
  breakMinutes Int      @default(0)
  status       String   @default("PLANNED") // PLANNED, WORKED, ABSENT
  templateId   String?
  note         String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?
  // Kaydı en son değiştiren. `updatedAt` "ne zaman"ı söylüyordu ama "kim"i değil;
  // bordro itirazında ("bu vardiyayı ben böyle yazmadım") cevap verilemiyordu.
  // Kiosktan atılan damgada da bu alan yazılır: değeri "kiosk:<employeeId>" olur,
  // çünkü damgayı atan bir Kobipo kullanıcısı değildir.
  updatedBy    String?

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  template ShiftTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([companyId, workDate])
  @@index([employeeId, workDate])
  @@map("work_shifts")
}

// İşletmenin tatil günü — işveren kendi belirler.
//
// NEDEN GÖMÜLÜ BİR TAKVİM DEĞİL: dinî bayramlar (Ramazan, Kurban) ay takvimine
// göre kaydığı için yıl yıl sabit bir listeden üretilemez; üstelik her işletme
// resmî tatilde çalışmaz/çalışır. Sabit tarihli resmî tatiller arayüzden tek
// tuşla eklenebilir (lib/personel/tatil.ts), kayanları işveren kendi girer.
//
// `recurring`: yalnızca AY+GÜN eşleşir, yıl yok sayılır — 1 Ocak'ı her yıl
// yeniden girmek gerekmesin. Kayan bayramlarda false olmalı, yoksa gelecek yıl
// yanlış güne düşer.
model CompanyHoliday {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  date        DateTime @db.Date
  recurring   Boolean  @default(false)
  // Arife günü: yarım gün tatil. Bu dakikadan SONRASI tatildir (13:00 → 780).
  // NULL = tam gün tatil.
  halfDayFrom Int?
  createdAt   DateTime @default(now())
  createdBy   String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, date])
  @@map("company_holidays")
}

// Bir haftalık vardiya planının YAYINLANMASI.
//
// NEDEN VARDİYADA DEĞİL DE AYRI TABLODA: yayın haftanın tamamına ait bir olaydır
// ("bu hafta kesinleşti, personele gitti"), tek tek vardiyaların değil. Her
// vardiyaya `publishedAt` konsaydı yayından sonra eklenen bir bar sessizce
// "yayınlanmamış" kalır ve haftanın durumu belirsizleşirdi. Burada hafta ya
// yayındadır ya değildir; yayından sonraki değişiklikler vardiyanın `updatedAt`
// alanıyla karşılaştırılıp "yayından sonra değişti" olarak gösterilir.
//
// `weekStart` her zaman PAZARTESİ'dir (lib/personel/vardiya.ts `weekStartIso`).
model ShiftPublication {
  id            String   @id @default(cuid())
  companyId     String
  weekStart     DateTime @db.Date
  publishedAt   DateTime @default(now())
  publishedBy   String?
  // Kaç personele e-posta gitti — "yayınlandı ama kimseye ulaşmadı" ayırt edilsin.
  notifiedCount Int      @default(0)
  // Yayın anındaki vardiya sayısı. "Yayından sonra değişti mi" sorusu tek başına
  // `updatedAt` ile cevaplanamıyor: SİLİNEN bir vardiya hiçbir zaman damgası
  // bırakmaz ve hafta sessizce yayınlanandan farklı hale gelirdi.
  shiftCount    Int      @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, weekStart])
  @@index([companyId, weekStart])
  @@map("shift_publications")
}

// Tekrar eden vardiya kalıbı ("Sabah 09:00–17:00") — takvimi tek tıkla doldurmak için.
model ShiftTemplate {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  startMinute  Int
  endMinute    Int
  breakMinutes Int      @default(0)
  color        String? // takvimdeki bar rengi (token adı); boşsa sırayla atanır
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shifts  WorkShift[]

  @@index([companyId])
  @@map("shift_templates")
}

model PayrollRecord {
  id             String    @id @default(cuid())
  companyId      String
  employeeId     String
  periodYear     Int
  periodMonth    Int // 1-12
  grossSalary    Decimal   @db.Decimal(12, 2)
  bonus          Decimal   @default(0) @db.Decimal(12, 2) // prim / mesai / ek ödeme
  advance        Decimal   @default(0) @db.Decimal(12, 2) // avans (net'ten düşülür)
  sgkDeduction   Decimal   @default(0) @db.Decimal(12, 2)
  taxDeduction   Decimal   @default(0) @db.Decimal(12, 2)
  otherDeduction Decimal   @default(0) @db.Decimal(12, 2)
  netSalary      Decimal   @db.Decimal(12, 2)
  status         String    @default("PENDING") // PENDING, PAID
  paymentDate    DateTime?
  accountId      String? // ödendiği finansal hesap
  transactionId  String? // ödeme (EXPENSE) işlemi bağı
  notes          String?   @db.Text
  createdAt      DateTime  @default(now())
  createdBy      String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, periodYear, periodMonth])
  @@index([companyId, periodYear, periodMonth])
  @@index([employeeId])
  @@map("payroll_records")
}

model LeaveRecord {
  id         String   @id @default(cuid())
  companyId  String
  employeeId String
  type       String // ANNUAL, EXCUSE, SICK, UNPAID
  startDate  DateTime
  endDate    DateTime
  days       Decimal  @db.Decimal(5, 1)
  status     String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reason     String?  @db.Text
  createdAt  DateTime @default(now())
  createdBy  String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([employeeId])
  @@map("leave_records")
}

model AssetAssignment {
  id           String    @id @default(cuid())
  companyId    String
  employeeId   String
  assetName    String
  category     String? // Bilgisayar, Telefon, Araç, ...
  serialNo     String?
  quantity     Int       @default(1)
  assignedDate DateTime  @default(now())
  returnDate   DateTime?
  status       String    @default("ASSIGNED") // ASSIGNED, RETURNED
  notes        String?   @db.Text
  createdAt    DateTime  @default(now())
  createdBy    String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([employeeId])
  @@map("asset_assignments")
}

model EmployeeDocument {
  id          String   @id @default(cuid())
  companyId   String
  employeeId  String
  title       String
  category    String? // Sözleşme, Kimlik, Diploma, Form, ...
  fileUrl     String?  @db.Text // Harici bağlantı (dosya yüklenmediyse)
  storagePath String?  @db.Text // Supabase Storage nesne yolu (dosya yüklendiyse)
  fileName    String? // Orijinal dosya adı
  mimeType    String? // application/pdf, ...
  fileSize    Int? // bayt
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  createdBy   String?

  employee Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  blob     EmployeeDocumentBlob?

  @@index([companyId])
  @@index([employeeId])
  @@map("employee_documents")
}

// Belge dosyasının ikili (binary) içeriği ayrı tabloda — liste/özet sorguları
// büyük dosya baytlarını çekmesin diye. Yalnızca indirme uç noktası okur.
model EmployeeDocumentBlob {
  id         String           @id @default(cuid())
  documentId String           @unique
  data       Bytes
  document   EmployeeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("employee_document_blobs")
}

// ————— İNDİRİM KODLARI —————
//
// Kobipo'nun KENDİ satışları (kontör paketi + abonelik/paket siparişi) için kupon.
// Değerlendirmenin TEK yeri lib/billing/discount.ts'tir: istemciden gelen tutara
// güvenilmez, indirim her zaman sunucuda kodun kendisinden yeniden hesaplanır.
//
// Fiyatlar KDV DAHİL tutulur (KOBIPO_PRICES_INCLUDE_VAT); indirim de KDV dahil
// tutar üzerinden hesaplanır. Faturada iskonto AYRI satır olarak işlenir: kalem
// liste fiyatından yazılır, indirim `InvoiceItem.discountAmount`a düşer.
model DiscountCode {
  id          String  @id @default(cuid())
  /// Büyük harfe normalize edilmiş kod (kullanıcı küçük harf yazsa da bulunur).
  code        String  @unique
  description String?
  /// PERCENT | AMOUNT
  type        String
  /// PERCENT'te yüzde (1-100), AMOUNT'ta TL (KDV dahil).
  value       Decimal @db.Decimal(10, 2)
  /// KONTOR | PACKAGE | ALL — kodun geçerli olduğu satış türü.
  scope       String  @default("ALL")
  /// Yüzde indirimde tavan (TL). Boş = tavansız.
  maxDiscount Decimal? @db.Decimal(10, 2)
  /// Asgari sipariş tutarı (TL, KDV dahil). Boş = alt sınır yok.
  minAmount   Decimal? @db.Decimal(10, 2)
  startsAt    DateTime?
  endsAt      DateTime?
  /// Toplam kullanım hakkı. Boş = sınırsız.
  maxRedemptions Int?
  /// Firma başına kullanım hakkı. Boş = sınırsız.
  maxPerCompany  Int?     @default(1)
   /// Abonelik YENİLEMELERİNDE de geçerli mi? False ise indirim yalnız ilk ödemeye
   /// uygulanır ve `Subscription.amount` LİSTE tutarıyla yazılır — yenileme tam
   /// fiyattan çekilir. True ise abonelik indirimli tutarla yenilenir.
   /// Kontör tek seferlik olduğu için bu alandan etkilenmez.
  appliesToRenewals Boolean @default(false)
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  redemptions DiscountCodeRedemption[]

  @@index([isActive])
  @@map("discount_codes")
}

 /// Kullanım kaydı — kod limitleri BURADAN sayılır. Satır yalnız ÖDEME BAŞARILI
 /// olduğunda yazılır: yarım kalan sipariş kimsenin hakkını yemez.
model DiscountCodeRedemption {
  id             String   @id @default(cuid())
  codeId         String
  companyId      String
  /// KONTOR | PACKAGE
  orderKind      String
  kontorOrderId  String?
  packageOrderId String?
  /// Uygulanan indirim (TL, KDV dahil).
  amount         Decimal  @db.Decimal(10, 2)
  /// Abonelik yenilemesinde mi kullanıldı?
  isRenewal      Boolean  @default(false)
  createdAt      DateTime @default(now())

  code    DiscountCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Aynı sipariş iki kez sayılmasın (çift callback bildirimi).
  @@unique([kontorOrderId])
  @@unique([packageOrderId])
  @@index([codeId, companyId])
  @@map("discount_code_redemptions")
}
