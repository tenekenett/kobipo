model AccountPlan {
  id        String   @id @default(cuid())
  companyId String
  code      String
  name      String
  parentId  String? // Üst hesap
  type      String // ASSET, LIABILITY, EQUITY, INCOME, EXPENSE
  level     Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent        AccountPlan?      @relation("AccountPlanHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      AccountPlan[]     @relation("AccountPlanHierarchy")
  debitEntries  AccountingEntry[] @relation("DebitEntries")
  creditEntries AccountingEntry[] @relation("CreditEntries")

  @@unique([companyId, code])
  @@index([companyId])
  @@index([parentId])
  @@map("account_plans")
}

model AccountingEntry {
  id              String   @id @default(cuid())
  companyId       String
  entryNo         String
  date            DateTime @default(now())
  description     String?  @db.Text
  debitAccountId  String
  creditAccountId String
  amount          Decimal  @db.Decimal(15, 2)
  reference       String? // Invoice ID, Transaction ID, etc.
  referenceType   String? // INVOICE, TRANSACTION, MANUAL, etc.
  createdAt       DateTime @default(now())
  createdBy       String?

  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  debitAccount  AccountPlan @relation("DebitEntries", fields: [debitAccountId], references: [id], onDelete: Restrict)
  creditAccount AccountPlan @relation("CreditEntries", fields: [creditAccountId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([date])
  @@index([debitAccountId])
  @@index([creditAccountId])
  @@map("accounting_entries")
}

// Sistem logları - Super Admin için
model SystemLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String // LOGIN, LOGOUT, CREATE, UPDATE, DELETE, ERROR
  entity    String? // User, Company, Invoice, etc.
  entityId  String?
  details   String?  @db.Text
  ipAddress String?
  userAgent String?  @db.Text
  level     String   @default("INFO") // INFO, WARN, ERROR
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@index([action])
  @@map("system_logs")
}

// Platform geneli ayarlar (key-value). Sistem yönetimi > Ayarlar sayfası tarafından kullanılır.
model SystemSetting {
  key       String   @id
  value     String?  @db.Text
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// Satılabilir hazır paket (bundle). Deneme planı (FREE_1Y) da bu tabloda tutulur.
// Hibrit fiyatlandırmada müşteri bir bundle seçip üzerine tekil modül/şube ekleyebilir
// (à la carte fiyatlar PricingItem tablosunda). Fiyatlar admin panelinden belirlenir.
model Plan {
  id                  String   @id @default(cuid())
  code                String   @unique
  name                String
  description         String?  @db.Text
  monthlyPrice        Decimal  @default(0) @db.Decimal(10, 2)
  yearlyPrice         Decimal? @db.Decimal(10, 2)
  // Paketin içerdiği modül anahtarları (MANAGEABLE_MODULES.key). Boş = temel/deneme paketi.
  includedModules     String[] @default([])
  // Pakete dahil ek şube sayısı (ana firma hariç). Ek şubeler bunun üstünde PricingItem[branch] ile.
  includedBranches    Int      @default(0)
  maxCompanies        Int      @default(1)
  maxUsers            Int      @default(1)
  maxInvoicesPerMonth Int      @default(100)
  highlighted         Boolean  @default(false) // Müşteri ekranında "Önerilen" rozeti
  sortOrder           Int      @default(0)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  subscriptions Subscription[]
  packageOrders PackageOrder[]

  @@map("plans")
}

// À la carte tekil fiyatlar (admin panelinden yönetilir). key örnekleri:
//   "module:sales", "module:purchase", ... (her MANAGEABLE_MODULES anahtarı)
//   "branch" (ek şube kotası birim fiyatı)
model PricingItem {
  key          String   @id
  label        String
  monthlyPrice Decimal  @default(0) @db.Decimal(10, 2)
  yearlyPrice  Decimal  @default(0) @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@map("pricing_items")
}

// Bir hesabın (kök/ana firma) aktif aboneliği. Hibrit + à la carte alımda tek bir
// bundle olmayabileceğinden planId opsiyoneldir; efektif haklar snapshot olarak tutulur.
model Subscription {
  id                     String    @id @default(cuid())
  userId                 String
  companyId              String
  planId                 String? // Seçilen bundle (varsa). Tam custom alımda null.
  provider               String    @default("NONE") // NONE | PAYTR
  providerSubscriptionId String? // PayTR recurring token (yinelenen ödeme)
  status                 String    @default("TRIAL") // TRIAL | ACTIVE | PAST_DUE | CANCELLED | EXPIRED
  billingCycle           String? // MONTHLY | YEARLY
  // Efektif açık modül anahtarları (snapshot). TRIAL'da boş bırakılır (hepsi açık kabul edilir).
  purchasedModules       String[]  @default([])
  branchQuota            Int       @default(0) // ana firma hariç izin verilen ek şube sayısı
  amount                 Decimal?  @db.Decimal(10, 2) // dönem tutarı (snapshot)
  autoRenew              Boolean   @default(false)
  cancelAtPeriodEnd      Boolean   @default(false)
  paymentRef             String?
  trialEndsAt            DateTime?
  periodStart            DateTime?
  periodEnd              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan?   @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@map("subscriptions")
}

// Müşterinin paket/abonelik satın alma siparişi. Ödeme PayTR üzerinden asenkron
// alındığından seçim önce burada tutulur; başarılı callback'te Subscription'a yansır.
// id = PayTR merchant_oid (kontör deseniyle aynı).
model PackageOrder {
  id              String             @id @default(cuid())
  companyId       String
  planId          String? // seçilen bundle (varsa)
  planName        String? // snapshot
  selectedModules String[]           @default([]) // bundle dışı ekstra seçilen modüller
  resolvedModules String[]           @default([]) // nihai açılacak modül seti (snapshot)
  branchQuota     Int                @default(0) // satın alınan ek şube kotası
  billingCycle    String // MONTHLY | YEARLY
  amount          Decimal            @db.Decimal(10, 2)
  currency        String             @default("TRY")
  autoRenew       Boolean            @default(true)
  status          PackageOrderStatus @default(PENDING_PAYMENT)
  // PayTR sanal POS alanları. merchant_oid = order.id (ayrı alan yok).
  paymentProvider String? // "PAYTR"
  paidAt          DateTime? // ödeme onay bildirimi (callback) anı
  paymentRef      String? // PayTR referansı / echo
  paymentError    String?            @db.Text // başarısız ödeme nedeni
  recurringToken  String? // PayTR recurring (kart) token'ı, varsa
  createdById     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan?   @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([status])
  @@map("package_orders")
}

model UsageLimit {
  id           String   @id @default(cuid())
  companyId    String
  key          String
  currentValue Int      @default(0)
  maxValue     Int
  periodStart  DateTime
  periodEnd    DateTime
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key, periodStart])
  @@map("usage_limits")
}

// Kobipo'nun sattığı kontör paketleri (sistem-admin tanımlar).
// Müşteri fiyatı Kobipo'ya aittir; mysoftTariffCode ise yüklemede (insertDocumentCredit) kullanılır.
model KontorPackage {
  id               String   @id @default(cuid())
  name             String // "1000 E-Belge"
  description      String?
  creditQty        Int // yüklenecek kontör adedi
  price            Decimal  @db.Decimal(10, 2) // Kobipo müşteri fiyatı
  currency         String   @default("TRY")
  mysoftTariffCode String // Mysoft İş Ortağı tarife kodu (getBusinessPartnerTariff)
  validityMonths   Int? // expiryDate hesabı; boşsa tarife default'u
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orders KontorOrder[]

  @@map("kontor_packages")
}

// Müşterinin kontör satın alma siparişi. Havale + sistem-admin onayı ile ilerler;
// onaylanınca bayi kimliğiyle Mysoft'a insertDocumentCredit yapılır.
model KontorOrder {
  id               String            @id @default(cuid())
  companyId        String
  packageId        String?
  // Sipariş anı snapshot'ı (paket sonradan değişse/silinse bile sabit kalır)
  packageName      String
  creditQty        Int
  unitPrice        Decimal           @db.Decimal(10, 2)
  totalPrice       Decimal           @db.Decimal(10, 2)
  currency         String            @default("TRY")
  mysoftTariffCode String
  targetVkn        String // kontörün yükleneceği mükellef VKN/TCKN
  status           KontorOrderStatus @default(PENDING_PAYMENT)
  paymentMethod    String            @default("HAVALE") // HAVALE | CARD
  receiptUrl       String? // dekont görseli/PDF
  // Sanal POS (PayTR) ödeme alanları. merchant_oid = order.id (ayrı alan yok).
  paymentProvider  String? // "PAYTR" (kart ödemesinde)
  paidAt           DateTime? // ödeme onay bildirimi (callback) anı
  paymentRef       String? // PayTR referansı / echo
  paymentError     String?           @db.Text // başarısız ödeme nedeni
  // Mysoft yükleme sonucu
  mysoftCreditId   String?
  loadError        String?           @db.Text
  // İz kayıtları
  createdById      String?
  confirmedById    String?
  confirmedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  package KontorPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([status])
  @@map("kontor_orders")
}

model Notification {
  id        String   @id @default(cuid())
  companyId String
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, isRead])
  @@map("notifications")
}

model Attachment {
  id         String   @id @default(cuid())
  companyId  String
  entityType String
  entityId   String
  fileName   String
  filePath   String
  mimeType   String?
  sizeBytes  Int?
  createdAt  DateTime @default(now())
  createdBy  String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, entityType, entityId])
  @@map("attachments")
}

model SupportTicket {
  id            String   @id @default(cuid())
  companyId     String
  subject       String
  message       String   @db.Text
  // Durum: OPEN (yeni), ANSWERED (admin yanıtladı), CLOSED (kapatıldı)
  status        String   @default("OPEN")
  // Kullanıcı, destek ekibinin hesabında inceleme/değişiklik yapmasına izin verdi mi?
  // Talep oluştururken opt-in olarak işaretlenir; ekip bu izni görür.
  accessConsent Boolean  @default(false)
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company   Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User                   @relation("SupportTicketCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  messages  SupportTicketMessage[]

  @@index([companyId, status])
  @@index([status])
  @@map("support_tickets")
}

// Destek talebi konuşma mesajları (açılış mesajı SupportTicket.message'tadır;
// bu tablo sonraki karşılıklı yanıtları tutar). isAdmin=true → sistem-admin yanıtı.
model SupportTicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  isAdmin   Boolean  @default(false)
  body      String   @db.Text
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("support_ticket_messages")
}

// Mysoft InvoiceInbox'tan çekilen gelen e-faturalar. Her senkronizasyonda
// (uuid = Mysoft ETTN) firma bazında upsert edilir; rawJson alanı Mysoft
// yanıtının tamamını saklar (KDV oran dağılımı, zarf durumu, vs. raporlar için).
model IncomingInvoice {
  id                 String    @id @default(cuid())
  companyId          String
  uuid               String // Mysoft ETTN (firma içinde unique)
  invoiceNo          String?
  docDate            DateTime?
  senderTaxNumber    String?
  senderName         String?
  profile            String? // TEMELFATURA | TICARIFATURA
  invoiceType        String? // SATIS | TEVKIFAT | IADE | ISTISNA ...
  currencyCode       String? // TRY, USD, EUR
  currencyRate       Decimal?  @db.Decimal(18, 6)
  taxExclusiveAmount Decimal?  @db.Decimal(18, 2) // KDV hariç
  taxInclusiveAmount Decimal?  @db.Decimal(18, 2) // KDV dahil
  vatAmount          Decimal?  @db.Decimal(18, 2) // Toplam KDV (taxTotalTra)
  payableAmount      Decimal?  @db.Decimal(18, 2) // Ödenecek
  vatBreakdown       Json? // {0:0, 1:0, 8:0, 10:0, 18:0, 20:220, ...}
  status             String? // KABUL | RED | BEKLEMEDE ...
  envelopeStatusCode String?
  envelopeStatusDesc String?
  pkAlias            String?
  gbAlias            String?
  isArchived         Boolean   @default(false)
  // Kobipo iç akışı:
  isLinkedToPurchase Boolean   @default(false) // Alış faturasına dönüştürüldü mü
  linkedInvoiceId    String? // İlişkili Kobipo Invoice (alış) id'si
  raw                Json // Mysoft ham yanıtı (item objesi)
  syncedAt           DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, uuid])
  @@index([companyId, docDate])
  @@index([companyId, status])
  @@map("incoming_invoices")
}

// ---------------------------------------------------------------------------
// PERSONEL (İK) MODÜLÜ
// Alt kayıtlar (bordro/izin/zimmet/belge) companyId skaler alanıyla sorgulanır;
// firma silinince Employee (company relation, Cascade) ve ona bağlı alt kayıtlar
// (employee relation, Cascade) birlikte silinir. Bu yüzden alt modeller Company'ye
// ayrı bir relation TAŞIMAZ — yalnızca Employee'nin company relation'ı yeterli.
// ---------------------------------------------------------------------------

model Employee {
  id               String    @id @default(cuid())
  companyId        String
  firstName        String
  lastName         String
  slug             String    @default("")
  nationalId       String? // TC Kimlik No
  email            String?
  phone            String?
  birthDate        DateTime?
  department       String?
  position         String? // Görev / Unvan
  hireDate         DateTime?
  terminationDate  DateTime?
  grossSalary      Decimal?  @db.Decimal(12, 2)
  iban             String?
  address          String?   @db.Text
  emergencyContact String?
  annualLeaveDays  Int       @default(14) // Yıllık izin hakkı (gün)
  status           String    @default("ACTIVE") // ACTIVE, ON_LEAVE, TERMINATED
  notes            String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payrolls  PayrollRecord[]
  leaves    LeaveRecord[]
  assets    AssetAssignment[]
  documents EmployeeDocument[]
  // Restoran modülünde bu personelin UYGULADIĞI hesap iskontoları. İK kartının
  // operasyona açılan ilk penceresi: bugüne kadar Employee ile satış tarafı
  // arasında hiçbir bağ yoktu (bkz. docs/restoran/PLAN.md "#7 vardiya/puantaj").
  ticketDiscounts RestaurantTicket[] @relation("TicketDiscountEmployee")
  // Bu personelin VERDİĞİ ikramlar. İki uçtan gelir ve ikisi de gerekli:
  // adisyonda kalem işaretlenirken (compItems), tezgâhta ise adisyon olmadığı
  // için doğrudan stok düzeltmesinde (compMovements).
  compItems       RestaurantTicketItem[] @relation("TicketItemCompEmployee")
  compMovements   StockMovement[]        @relation("StockMovementEmployee")

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([companyId, status])
  @@map("employees")
}

model PayrollRecord {
  id             String    @id @default(cuid())
  companyId      String
  employeeId     String
  periodYear     Int
  periodMonth    Int // 1-12
  grossSalary    Decimal   @db.Decimal(12, 2)
  bonus          Decimal   @default(0) @db.Decimal(12, 2) // prim / mesai / ek ödeme
  advance        Decimal   @default(0) @db.Decimal(12, 2) // avans (net'ten düşülür)
  sgkDeduction   Decimal   @default(0) @db.Decimal(12, 2)
  taxDeduction   Decimal   @default(0) @db.Decimal(12, 2)
  otherDeduction Decimal   @default(0) @db.Decimal(12, 2)
  netSalary      Decimal   @db.Decimal(12, 2)
  status         String    @default("PENDING") // PENDING, PAID
  paymentDate    DateTime?
  accountId      String? // ödendiği finansal hesap
  transactionId  String? // ödeme (EXPENSE) işlemi bağı
  notes          String?   @db.Text
  createdAt      DateTime  @default(now())
  createdBy      String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, periodYear, periodMonth])
  @@index([companyId, periodYear, periodMonth])
  @@index([employeeId])
  @@map("payroll_records")
}

model LeaveRecord {
  id         String   @id @default(cuid())
  companyId  String
  employeeId String
  type       String // ANNUAL, EXCUSE, SICK, UNPAID
  startDate  DateTime
  endDate    DateTime
  days       Decimal  @db.Decimal(5, 1)
  status     String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reason     String?  @db.Text
  createdAt  DateTime @default(now())
  createdBy  String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([employeeId])
  @@map("leave_records")
}

model AssetAssignment {
  id           String    @id @default(cuid())
  companyId    String
  employeeId   String
  assetName    String
  category     String? // Bilgisayar, Telefon, Araç, ...
  serialNo     String?
  quantity     Int       @default(1)
  assignedDate DateTime  @default(now())
  returnDate   DateTime?
  status       String    @default("ASSIGNED") // ASSIGNED, RETURNED
  notes        String?   @db.Text
  createdAt    DateTime  @default(now())
  createdBy    String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([employeeId])
  @@map("asset_assignments")
}

model EmployeeDocument {
  id          String   @id @default(cuid())
  companyId   String
  employeeId  String
  title       String
  category    String? // Sözleşme, Kimlik, Diploma, Form, ...
  fileUrl     String?  @db.Text // Harici bağlantı (dosya yüklenmediyse)
  storagePath String?  @db.Text // Supabase Storage nesne yolu (dosya yüklendiyse)
  fileName    String? // Orijinal dosya adı
  mimeType    String? // application/pdf, ...
  fileSize    Int? // bayt
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  createdBy   String?

  employee Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  blob     EmployeeDocumentBlob?

  @@index([companyId])
  @@index([employeeId])
  @@map("employee_documents")
}

// Belge dosyasının ikili (binary) içeriği ayrı tabloda — liste/özet sorguları
// büyük dosya baytlarını çekmesin diye. Yalnızca indirme uç noktası okur.
model EmployeeDocumentBlob {
  id         String           @id @default(cuid())
  documentId String           @unique
  data       Bytes
  document   EmployeeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("employee_document_blobs")
}
