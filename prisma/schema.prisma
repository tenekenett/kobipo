  status     String   @default("PORTFÖYDE") // PORTFÖYDE, CİRO_EDİLDİ, TAHSİL_EDİLDİ, İADE_EDİLDİ, PROTESTOLU
  direction  String? // RECEIVED (alınan) | GIVEN (verilen). null = eski kayıt: müşteri=alınan, tedarikçi=verilen.
  customerId String?
  supplierId String?
