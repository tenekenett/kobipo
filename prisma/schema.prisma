// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Serverless (Vercel): use Transaction pooler :6543 + ?pgbouncer=true (IPv4-friendly).
  // Migrations / db push: set DIRECT_URL to Session pooler or Direct (see CONNECTION_FIX.md).
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Kullanıcı rolleri
enum Role {
  ADMIN // Firma yöneticisi - tam yetki
  BRANCH_MANAGER // Şube müdürü - şubede tam operasyonel yetki, hesap yönetimi (ekip/şube/abonelik) hariç
  ACCOUNTANT // Muhasebeci
  STOCK // Stokçu
  SALES // Satış
  VIEWER // Görüntüleyici - sadece okuma
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

enum EDonusumIntegrator {
  GIB_PORTAL
  OZEL_ENTEGRATOR
}

enum CompanyDefinitionType {
  CLASS_1
  CLASS_2
  PRODUCT_CATEGORY
}

// Kontör satın alma sipariş durumları (bayi/İş Ortağı modeli)
enum KontorOrderStatus {
  PENDING_PAYMENT // Sipariş oluştu, ödeme/dekont bekleniyor
  PAYMENT_REVIEW // Dekont yüklendi, sistem-admin onayı bekliyor
  LOADED // Ödeme onaylandı ve Mysoft'a kontör yüklendi
  REJECTED // Reddedildi (ödeme bulunamadı vb.)
  FAILED // Onaylandı ama Mysoft yüklemesi başarısız oldu
}

// Paket/abonelik satın alma sipariş durumları (PayTR sanal POS)
enum PackageOrderStatus {
  PENDING_PAYMENT // Sipariş oluştu, PayTR ödemesi bekleniyor
  ACTIVE // Ödeme onaylandı, abonelik uygulandı
  FAILED // Ödeme başarısız
  CANCELLED // İptal edildi
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String?
  // Kayıt formunda sorulan firma ünvanı + ayırt edici şube ismi. Kayıt anında henüz
  // Company kaydı yoktur; ilk firma oluşturulurken (/companies/new) form bu iki
  // değerle ön doldurulur ve Company.name / Company.branchName'e taşınır.
  companyDisplayName String?
  companyBranchName  String?
  phone              String?
  password           String
  emailVerified      DateTime?
  image              String?
  isSuperAdmin       Boolean   @default(false) // Sistem yöneticisi
  isBlogEditor       Boolean   @default(false) // Platform blog editörü - yalnız /blog-admin erişimi
  twoFactorSecret    String?
  twoFactorEnabled   Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  companies           UserCompany[]
  accounts            Account[]
  sessions            Session[]
  systemLogs          SystemLog[]
  subscriptions       Subscription[]
  supportTickets      SupportTicket[]      @relation("SupportTicketCreatedBy")
  authorizedCustomers Customer[]           @relation("AuthorizedCustomerUser")
  authorizedSuppliers Supplier[]           @relation("AuthorizedSupplierUser")
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

// Kobipo pazarlama blogu — platform seviyesi içerik (firmaya bağlı DEĞİL).
// İçerik blog editörü (User.isBlogEditor) tarafından /blog-admin panelinden yönetilir.
model BlogPost {
  id            String         @id @default(cuid())
  slug          String         @unique
  title         String
  excerpt       String         @db.Text
  category      String
  body          String         @db.Text // Markdown
  coverTone     String         @default("blue") // "blue" | "navy" | "green" (kapak görseli yoksa gradyan)
  coverImageUrl String?
  readTime      String?
  author        String
  status        BlogPostStatus @default(DRAFT)
  publishedAt   DateTime?
  createdBy     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, publishedAt])
  @@map("blog_posts")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Brute-force koruması: başarısız giriş denemelerini IP bazlı sayar; eşik aşılınca IP'yi
// geçici kilitler. `authorize` (lib/auth/config.ts) fail-open kullanır — bu tabloya
// erişilemezse giriş ENGELLENMEZ (kilit yalnızca ek savunma katmanıdır).
model LoginAttempt {
  id          String    @id @default(cuid())
  ip          String    @unique
  failedCount Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
  lastEmail   String?
  updatedAt   DateTime  @updatedAt

  @@index([lockedUntil])
  @@map("login_attempts")
}

model Company {
  id                        String             @id @default(cuid())
  slug                      String             @unique @default("")
  // `name` resmi ÜNVAN'dır (faturada/e-belgede basılan ad). Aynı tüzel kişinin birden
  // çok şubesi aynı ünvanı taşıdığı için firma seçicide ayırt edilemiyordu; `branchName`
  // yalnızca ARAYÜZ için kısa ayırt edici addır (ör. "Kadıköy"). Seçici ve şube
  // listelerinde ünvanın yanına parantez içinde eklenir — bkz. lib/company/display-name.ts.
  // Belge/e-fatura içeriğinde KULLANILMAZ. NULL/boş = yalnızca ünvan gösterilir.
  name                      String
  branchName                String?
  // Şubeler ana firmayla aynı VKN'yi paylaşabildiği için taxNumber global benzersiz
  // DEĞİLDİR. Aynı tüzel kişinin (parentCompanyId) birden fazla şubesi olabilir.
  taxNumber                 String?
  taxOffice                 String?
  address                   String?            @db.Text
  city                      String?
  country                   String             @default("TR")
  phone                     String?
  email                     String?
  website                   String?
  isEDonusumEnabled         Boolean            @default(false)
  eDonusumIntegrator        EDonusumIntegrator @default(GIB_PORTAL)
  eDonusumProvider          String?
  eDonusumApiUsername       String?
  eDonusumApiPassword       String?            @db.Text
  eDonusumAlias             String?
  eDonusumApiUrl            String?
  eDonusumLastTestedAt      DateTime?
  eDonusumLastTestSuccess   Boolean?
  invoiceSeriesPrefix       String?
  // Fiş (hızlı satış/alış) tasarım şablonu: logo, üst başlık, alt not, görünürlük
  // tercihleri, kağıt genişliği. Şekil: lib/fis/receipt-template.ts (ReceiptTemplate).
  // Boşsa varsayılan (bugünkü sabit) fiş görünümü kullanılır.
  receiptTemplate           Json?
  eFaturaPrefix             String?
  eArchivePrefix            String?
  // Geçmiş tarihli belgeler için ayrılmış (alternatif) Mysoft serileri. Bir seride
  // belge numaraları tarih sırasını bozamadığı için, ana seride daha yeni tarihli
  // belge varken geçmiş tarihli fatura reddedilir; bu seriler yalnız o durumda
  // devreye girer (send-invoice-helper.ts). NULL = tanımlı değil.
  eFaturaBackdatePrefix     String?
  eArchiveBackdatePrefix    String?
  eDonusumTenantVkn         String?
  eDonusumConnectorGuid     String?
  eDonusumPkAlias           String?
  eDonusumGbAlias           String?
  // Bayi (İş Ortağı) self-servis hesap açma durum takibi. Bkz. docs/e-donusum-onboarding/PLAN.md
  eDonusumOnboardingStatus  String? // NONE | TENANT_CREATED | ACTIVATION_PENDING | ACTIVE | FAILED
  eDonusumTenantCreatedAt   DateTime?
  eDonusumActivatedProducts String[]           @default([]) // ör. ["EInvoice","EArchive"]
  eDonusumActivationError   String?            @db.Text
  sector                    String?
  businessModel             String?
  employeeRange             String?
  monthlyInvoiceVolume      String?
  primaryBusinessNeed       String?
  usesEDonusumBefore        Boolean?
  onboardingCompletedAt     DateTime?
  isActive                  Boolean            @default(true) // Firma aktif/pasif durumu
  disabledModules           String[]           @default([]) // Kapalı modül anahtarları (boş = tüm modüller açık)
  // Şube ise ana firmaya işaret eder; ana (merkez) firmada null'dır. Şube,
  // ana firmayla aynı VKN/vergi dairesi/e-Dönüşüm kimliğini paylaşır (mağaza gibi).
  parentCompanyId           String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  parentCompany Company?  @relation("CompanyBranches", fields: [parentCompanyId], references: [id], onDelete: Cascade)
  branches      Company[] @relation("CompanyBranches")

  users                   UserCompany[]
  customers               Customer[]
  suppliers               Supplier[]
  products                Product[]
  financialAccounts       FinancialAccount[]
  transactions            Transaction[]
  invoices                Invoice[]
  quotes                  Quote[]
  orders                  Order[]
  paymentLinks            PaymentLink[]
  stockMovements          StockMovement[]
  invoicePayments         InvoicePayment[]
  checks                  Check[]
  promissoryNotes         PromissoryNote[]
  warehouses              Warehouse[]
  accountPlans            AccountPlan[]
  accountingEntries       AccountingEntry[]
  waybills                Waybill[]
  bankStatements          BankStatement[]
  cashCounts              CashCount[]
  subscriptions           Subscription[]
  usageLimits             UsageLimit[]
  notifications           Notification[]
  attachments             Attachment[]
  supportTickets          SupportTicket[]
  invitations             CompanyInvitation[]
  definitions             CompanyDefinition[]
  incomingInvoices        IncomingInvoice[]
  employees               Employee[]
  kontorOrders            KontorOrder[]
  packageOrders           PackageOrder[]
  eInvoiceTemplates       EInvoiceTemplate[]
  eInvoiceSeriesTemplates EInvoiceSeriesTemplate[]
  labelTemplates          LabelTemplate[]
  productRecipes          ProductRecipe[]
  restaurantAreas         RestaurantArea[]
  restaurantTables        RestaurantTable[]
  restaurantTickets       RestaurantTicket[]
  restaurantPlanItems     RestaurantPlanItem[]
  restaurantReservations  RestaurantReservation[]
  productOptionGroups     ProductOptionGroup[]

  @@index([parentCompanyId])
  @@map("companies")
}

// Kobipo Şablon Tasarımcısı ile üretilen belge dizaynları ve firmanın gönderimde
// kullanacağı aktif şablon seçimi. Mysoft saved-XSLT içeriğini geri vermediği için
// önizleme/tekrar-üretim adına tasarım seçeneklerini (options) burada saklarız.
// `isActive` = bu firma + belge tipi için fatura gönderirken kullanılacak şablon
// (Mysoft payload'ındaki xsltName ile eşleşir). Set-default API'si olmadığından
// "varsayılan" seçimi Kobipo tarafında tutulur.
model EInvoiceTemplate {
  id            String   @id @default(cuid())
  companyId     String
  eDocumentType Int // 1=E-Fatura, 2=E-Arşiv
  xsltName      String // Mysoft'a verilen şablon adı (eşleşme anahtarı)
  options       Json? // Tasarımcı seçenekleri; yoksa dışarıdan/portal şablonu (önizlenemez)
  isActive      Boolean  @default(false)
  // Mysoft XSLT silmeyi desteklemediğinden "silme" = Kobipo tarafında listeden gizleme.
  // hidden=true ise şablon listede gösterilmez (Mysoft hesabında fiziksel olarak kalır).
  hidden        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, eDocumentType, xsltName])
  @@index([companyId, eDocumentType])
  @@map("einvoice_templates")
}

// Seri no (prefix) → belge şablonu eşlemesi. Bir prefix'e (ör. "ERA") belirli bir
// kayıtlı tasarımı (xsltName, ör. "Kurumsal Mavi") atamak için kullanılır. Fatura
// gönderiminde faturanın prefix'ine atanmış şablon, firma genel aktif şablonundan
// önce gelir. Eşleme yoksa EInvoiceTemplate.isActive (firma geneli) kullanılır.
model EInvoiceSeriesTemplate {
  id            String   @id @default(cuid())
  companyId     String
  eDocumentType Int // 1=E-Fatura, 2=E-Arşiv
  prefix        String // Mysoft numaratör prefix'i (ör. "ERA")
  xsltName      String // Atanan şablon adı (Mysoft xsltName / kayıtlı tasarım)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, eDocumentType, prefix])
  @@index([companyId, eDocumentType])
  @@map("einvoice_series_templates")
}

model UserCompany {
  id        String    @id @default(cuid())
  userId    String
  companyId String
  role      Role      @default(VIEWER) // Varsayılan: görüntüleyici
  invitedBy String?
  invitedAt DateTime?
  createdAt DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@map("user_companies")
}

model CompanyInvitation {
  id         String    @id @default(cuid())
  companyId  String
  email      String
  role       Role
  token      String    @unique
  invitedBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([email])
  @@map("company_invitations")
}

model Customer {
  id                   String    @id @default(cuid())
  companyId            String
  code                 String?
  // `name` resmi ünvandır (faturada/e-belgede basılır). `nickname` günlük hayatta
  // kullanılan takma addır ("Ali Usta", "Köşedeki bakkal") — yalnızca ARAYÜZ içindir:
  // listede ünvanın altında görünür ve cari aramasında eşleşir. Belgelere yazılmaz.
  name                 String
  nickname             String?
  taxNumber            String?
  taxOffice            String?
  address              String?   @db.Text
  city                 String?
  district             String?
  country              String    @default("TR")
  phone                String?
  email                String?
  contactPerson        String?
  // Pinlenen GİB posta kutusu (alias). Birden çok PK'sı olan alıcıya e-Fatura
  // gönderirken tercih edilen kutu; boşsa Mysoft ilk geçerli PK'yı otomatik seçer.
  eInvoiceAlias        String?
  paymentDueDays       Int?
  openingBalanceAmount Decimal   @default(0) @db.Decimal(14, 2)
  openingBalanceType   String    @default("DEBIT")
  riskLimit            Decimal?  @db.Decimal(14, 2)
  bankInfo             String?   @db.Text
  note                 String?   @db.Text
  classification1Id    String?
  classification2Id    String?
  authorizedUserId     String?
  slug                 String    @default("")
  isAlsoSupplier       Boolean   @default(false)
  linkedSupplierId     String?
  archivedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  linkedSupplier  Supplier?          @relation("CustomerSupplierLink", fields: [linkedSupplierId], references: [id], onDelete: SetNull)
  invoices        Invoice[]
  quotes          Quote[]
  orders          Order[]
  transactions    Transaction[]
  checks          Check[]
  promissoryNotes PromissoryNote[]
  waybills        Waybill[]
  branches        CustomerBranch[]
  classification1 CompanyDefinition? @relation("CustomerClassification1", fields: [classification1Id], references: [id], onDelete: SetNull)
  classification2 CompanyDefinition? @relation("CustomerClassification2", fields: [classification2Id], references: [id], onDelete: SetNull)
  authorizedUser  User?              @relation("AuthorizedCustomerUser", fields: [authorizedUserId], references: [id], onDelete: SetNull)
  restaurantTickets RestaurantTicket[]

  @@unique([linkedSupplierId])
  @@unique([companyId, slug])
  @@index([companyId])
  @@index([companyId, name])
  @@index([companyId, archivedAt])
  @@index([classification1Id])
  @@index([classification2Id])
  @@index([authorizedUserId])
  @@map("customers")
}

model Supplier {
  id                   String    @id @default(cuid())
  companyId            String
  code                 String?
  // Bkz. Customer.nickname — takma ad, yalnızca arayüz/arama içindir.
  name                 String
  nickname             String?
  taxNumber            String?
  taxOffice            String?
  address              String?   @db.Text
  city                 String?
  district             String?
  country              String    @default("TR")
  phone                String?
  email                String?
  contactPerson        String?
  // Pinlenen GİB posta kutusu (alias). Birden çok PK'sı olan alıcıya e-Fatura
  // gönderirken tercih edilen kutu; boşsa Mysoft ilk geçerli PK'yı otomatik seçer.
  eInvoiceAlias        String?
  paymentDueDays       Int?
  openingBalanceAmount Decimal   @default(0) @db.Decimal(14, 2)
  openingBalanceType   String    @default("DEBIT")
  riskLimit            Decimal?  @db.Decimal(14, 2)
  bankInfo             String?   @db.Text
  note                 String?   @db.Text
  classification1Id    String?
  classification2Id    String?
  authorizedUserId     String?
  slug                 String    @default("")
  isAlsoCustomer       Boolean   @default(false)
  linkedCustomerId     String?
  archivedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  linkedCustomers Customer[]         @relation("CustomerSupplierLink")
  invoices        Invoice[]
  quotes          Quote[]
  orders          Order[]
  transactions    Transaction[]
  checks          Check[]
  promissoryNotes PromissoryNote[]
  waybills        Waybill[]
  classification1 CompanyDefinition? @relation("SupplierClassification1", fields: [classification1Id], references: [id], onDelete: SetNull)
  classification2 CompanyDefinition? @relation("SupplierClassification2", fields: [classification2Id], references: [id], onDelete: SetNull)
  authorizedUser  User?              @relation("AuthorizedSupplierUser", fields: [authorizedUserId], references: [id], onDelete: SetNull)

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([companyId, name])
  @@index([companyId, archivedAt])
  @@index([classification1Id])
  @@index([classification2Id])
  @@index([authorizedUserId])
  @@map("suppliers")
}

model CompanyDefinition {
  id        String                @id @default(cuid())
  companyId String
  type      CompanyDefinitionType
  label     String
  isActive  Boolean               @default(true)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  company             Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerClass1Items Customer[] @relation("CustomerClassification1")
  customerClass2Items Customer[] @relation("CustomerClassification2")
  supplierClass1Items Supplier[] @relation("SupplierClassification1")
  supplierClass2Items Supplier[] @relation("SupplierClassification2")

  @@unique([companyId, type, label])
  @@index([companyId, type, isActive])
  @@map("company_definitions")
}

model CustomerBranch {
  id         String   @id @default(cuid())
  customerId String
  name       String
  address    String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_branches")
}

model Product {
  id                       String   @id @default(cuid())
  companyId                String
  code                     String?
  name                     String
  barcode                  String?
  slug                     String   @default("")
  category                 String? // Ürün kategorisi/grubu (serbest metin; varyant ileride)
  unit                     String   @default("ADET")
  vatRate                  Decimal  @default(20) @db.Decimal(5, 2)
  purchasePrice            Decimal? @db.Decimal(15, 6) // 6 ondalık: e-Fatura birim fiyat hassasiyeti
  salePrice                Decimal? @db.Decimal(15, 6) // 6 ondalık: e-Fatura birim fiyat hassasiyeti
  // Ürün fiyatının para birimi. TRY dışıysa (USD/EUR) satış/teklif ekranında güncel
  // TCMB kuruyla belge para birimine çevrilir.
  currency                 String   @default("TRY")
  // Fiyatlar DB'de DAİMA net (KDV hariç) saklanır. Aşağıdaki bayraklar yalnızca
  // kullanıcının fiyatı KDV dahil girip girmediğini hatırlamak/formu o modda
  // göstermek içindir — hesaplamaları etkilemez.
  salePriceVatIncluded     Boolean  @default(false)
  purchasePriceVatIncluded Boolean  @default(false)
  // 4 ondalık: reçeteli satışta gram/mililitre düşümü. Kahve KG cinsinden
  // tutulurken 20 gr = 0,02; 5 ml vanilya LT cinsinden 0,005 eder — 2 ondalık
  // bunları yuvarlayıp sessizce kaybederdi. En küçük birim 0,0001 (0,1 gram).
  stockQuantity            Decimal  @default(0) @db.Decimal(14, 4)
  minStockLevel            Decimal? @db.Decimal(14, 4)
  isService                Boolean  @default(false)
  // Satış/menü ekranlarında listelenir mi? Varsayılan true — mevcut ürünler
  // etkilenmez. Hizmetlerde ANLAMSIZDIR: her iki satış ekranı da isService
  // ürünleri baştan dışlıyor.
  isSellable               Boolean  @default(true)
  // Reçetelerde bileşen olarak kullanılan bir kalem mi (süt, kahve çekirdeği)?
  //
  // `isSellable` ile BİRBİRİNİ DIŞLAMAZ: kahve çekirdeği hem 250 gr paket olarak
  // satılabilir (isSellable=true) hem de latte reçetesinde bileşen olabilir
  // (isIngredient=true) — tek kart, tek stok bakiyesi.
  //
  // DİKKAT — bu alan yalnızca SUNUM/FİLTRELEME içindir (Menü & Reçeteler
  // sekmeleri, /stok filtresi). Bir ürünün reçetede kullanılabilmesini
  // ENGELLEMEZ: reçete motoru hâlâ ProductRecipeItem'a bakar. Böylece bayrak
  // gerçekle çelişse bile (işaretli ama hiçbir reçetede yok, ya da tersi)
  // stok/maliyet hesabı sessizce bozulmaz — yalnızca ürün yanlış sekmede görünür.
  isIngredient             Boolean  @default(false)
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stockMovements  StockMovement[]
  invoiceItems    InvoiceItem[]
  quoteItems      QuoteItem[]
  orderItems      OrderItem[]
  warehouseStocks WarehouseStock[]
  waybillItems    WaybillItem[]
  // Bu ürünün reçetesi (mamül/yarı mamül ise) ve bu ürünün bileşen olarak
  // geçtiği reçete kalemleri (hammadde/yarı mamül ise).
  recipe          ProductRecipe?      @relation("RecipeProduct")
  usedInRecipes   ProductRecipeItem[] @relation("RecipeComponent")
  ticketItems     RestaurantTicketItem[]
  optionGroups    ProductOptionGroup[]
  // Bu ürünün seçenek reçete etkisinde geçtiği yerler (süt → soya sütü).
  optionEffectFrom ProductOption[] @relation("OptionEffectFrom")
  optionEffectTo   ProductOption[] @relation("OptionEffectTo")

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([companyId, category])
  @@map("products")
}

// Bir ürünün hangi bileşenlerden oluştuğu (reçete / BOM). Satış anında mamülün
// KENDİSİ stoktan düşmez; bileşenleri düşer. Bir bileşenin de reçetesi varsa
// (yarı mamül, ör. "Espresso") özyinelemeli olarak hammaddeye kadar açılır —
// yarı mamüller SANALDIR, stok bakiyeleri tutulmaz. Bkz. lib/stock/recipe-expand.ts
//
// Yarı mamül için ayrı bir tip/bayrak yoktur: yarı mamül = reçetesi olan ve
// isSellable=false olan ürün. Genişletme kuralı tek cümledir:
// "bileşenin aktif reçetesi VARSA açılır, YOKSA düşülür."
model ProductRecipe {
  id            String   @id @default(cuid())
  companyId     String
  productId     String   @unique // ürün başına tek reçete
  // Reçete kaç adet mamül üretir. Bileşen miktarları buna bölünerek birim
  // başına düşen miktar bulunur (ör. 10 porsiyonluk sos reçetesi → yield 10).
  yieldQuantity Decimal  @default(1) @db.Decimal(12, 4)
  isActive      Boolean  @default(true)
  note          String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product             @relation("RecipeProduct", fields: [productId], references: [id], onDelete: Cascade)
  items   ProductRecipeItem[]

  @@index([companyId])
  @@map("product_recipes")
}

model ProductRecipeItem {
  id                 String   @id @default(cuid())
  recipeId           String
  componentProductId String
  // Aşağıdaki `unit` cinsinden miktar. Bileşenin STOK biriminden farklı
  // olabilir (süt LT stoklanır, reçetede 200 ML geçer); dönüşüm aynı birim
  // ailesi içinde yapılır — bkz. lib/data/units.ts convertUnit().
  quantity           Decimal  @db.Decimal(14, 4)
  unit               String
  wastageRate        Decimal? @db.Decimal(5, 2) // fire yüzdesi (opsiyonel)
  order              Int      @default(0)

  recipe    ProductRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  // Restrict: bir reçetede kullanılan hammadde silinemesin.
  component Product       @relation("RecipeComponent", fields: [componentProductId], references: [id], onDelete: Restrict)

  @@unique([recipeId, componentProductId])
  @@index([componentProductId])
  @@map("product_recipe_items")
}

// ─── Restoran & Kafe Aşama 2: masa, salon planı ve adisyon ─────────────────────
// Kararlar: docs/restoran/ASAMA2.md · yön: docs/restoran/PLAN.md "Adım 7"

// Bölge/salon: "Bahçe", "Üst Kat". Salon planı ekranında sekme olur.
model RestaurantArea {
  id        String   @id @default(cuid())
  companyId String
  name      String
  order     Int      @default(0)
  // Bölge = bir KROKİ. Tuval kare olduğu için tek bir kenar uzunluğu yeter
  // (hücre cinsinden): küçük kafe 12'de kalır, çok masalı mekân 32'ye çıkar.
  gridSize  Int      @default(16)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tables    RestaurantTable[]
  planItems RestaurantPlanItem[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("restaurant_areas")
}

// Salon planındaki masa DIŞI öğeler — dükkan krokisi: duvar, kapı, bar, mutfak,
// WC, merdiven, bitki, serbest yazı.
//
// Masayla aynı ızgara koordinatını kullanır ama ayrı tablodur: masanın kimliği
// (adisyon, ciro, kapasite) var, duvarın yok. Aynı tabloda yaşasalardı her
// "masaları getir" sorgusu duvarları da eleyip durmak zorunda kalırdı ve
// "boş masa" sayacına duvar karışması an meselesiydi.
//
// Plan öğeleri ADİSYON AKIŞINA GİRMEZ: kullanım kipinde tıklanamaz, yalnız
// düzenleme kipinde taşınır/silinir.
model RestaurantPlanItem {
  id        String   @id @default(cuid())
  companyId String
  areaId    String?
  kind      String // WALL | DOOR | BAR | KITCHEN | WC | STAIRS | PLANT | TEXT
  label     String?
  x         Int      @default(0)
  y         Int      @default(0)
  width     Int      @default(2)
  height    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  area    RestaurantArea? @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([areaId])
  @@map("restaurant_plan_items")
}

// Masa. Yerleşim (x/y/width/height) BU SATIRDA durur, ayrı bir plan JSON'unda
// değil: masanın kimliği var (adisyonu, cirosu) ve iki yerde yaşarsa ikisi
// ayrışır. Gerekçenin tamamı ASAMA2.md "Neden koordinat masanın satırında".
//
// Birim: salon planı ızgara hücresi (piksel değil) — ekran ölçeği değişince
// yerleşim bozulmasın.
model RestaurantTable {
  id        String   @id @default(cuid())
  companyId String
  areaId    String?
  name      String
  capacity  Int?
  shape     String   @default("SQUARE") // SQUARE | CIRCLE | RECT
  x         Int      @default(0)
  y         Int      @default(0)
  width     Int      @default(2)
  height    Int      @default(2)
  // Hesap kapandı, masa henüz toplanmadı. Adisyon kapanışında damgalanır.
  //
  // Masayı KİLİTLEMEZ: üzerine yeni adisyon açmak damgayı temizler. Kilitleseydi
  // "temizlik" kullanmayan bir işletmede her masa iki dokunuş isterdi; böyle
  // yalnız bilgi verir (garson hangi masanın toplanacağını plandan görür).
  cleaningSince DateTime?
  // Masa SİLİNMEZ, pasifleştirilir: geçmiş adisyonlar masasız kalmasın.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  area         RestaurantArea?         @relation(fields: [areaId], references: [id], onDelete: SetNull)
  tickets      RestaurantTicket[]
  reservations RestaurantReservation[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([areaId])
  @@map("restaurant_tables")
}

// Adisyon — masaya bağlı, saatlerce açık kalan ÇALIŞMA kaydı. Resmî belge değil;
// kapanışta v1'in fiş yoluna bağlanır (`isReceipt: true`) ve stok O ANDA düşer.
//
// `tableId` opsiyonel: paket/gel-al adisyonu masasız açılır.
model RestaurantTicket {
  id         String    @id @default(cuid())
  companyId  String
  tableId    String?
  code       String // ADS-2026-0001
  status     String    @default("OPEN") // OPEN | CLOSED | CANCELLED
  guestCount Int?
  note       String?   @db.Text
  customerId String?
  // Adisyon (hesap) iskontosu. PERCENT → yüzde, AMOUNT → KDV DAHİL tutar:
  // kullanıcı hesabın altındaki rakama bakarak "50 lira indirim" der. Fişe
  // giderken matrah bazına çevrilir (Invoice.globalDiscountAmount NET bekler).
  // Kalem bazlı iskonto YOK — kafede nadir, üç ekranda daha düzeltme demek.
  discountType   String? @db.VarChar(10) // PERCENT | AMOUNT
  discountValue  Decimal? @db.Decimal(12, 2)
  // Sebep artık İKİ alan: sabit kod (rapor gruplar) + serbest açıklama (kasiyer
  // yazar). Kalem ve iptal sebeplerindeki kuralın aynısı — serbest metin tek
  // başına kalsaydı "Personel"/"personel"/"personele" üç ayrı satır olurdu.
  discountReasonCode String? @db.VarChar(30)
  discountReason String?  @db.VarChar(255)
  // İskontoyu UYGULAYAN personel — İK kartı (Employee), login kullanıcısı DEĞİL.
  // Kafede kasa çoğu zaman ortak hesapla açıktır; "indirimi kim verdi" sorusunun
  // cevabı oturumu açan kişi değil, o an masaya bakan garsondur. İskonto silinince
  // birlikte temizlenir; personel kartı silinirse bağ kopar (SetNull), iskonto kalır.
  discountEmployeeId String?
  // Oturum izi: kaydı fiilen yazan kullanıcı ve anı. `billRequestedBy` deseniyle
  // aynı — seçilen personelden AYRI tutulur, ikisi farklı soruyu cevaplar.
  discountBy String?
  discountAt DateTime?
  openedAt   DateTime  @default(now())
  openedBy   String?
  // Müşteri hesap istedi — masa planda ayrı renge döner. Adisyon hâlâ AÇIKTIR
  // (kalem eklenebilir); bu yalnız "kasaya git" işaretidir. Kapanışta temizlenir
  // ki masanın sonraki müşterisi devralmasın.
  billRequestedAt DateTime?
  billRequestedBy String?
  closedAt   DateTime?
  closedBy   String?
  // Kapanışta oluşan fiş. Fatura silinirse bağ kopar (SetNull), adisyon geçmişte kalır.
  invoiceId  String?   @unique
  // Bu adisyon başka bir adisyona BİRLEŞTİRİLDİYSE hedefin id'si. Kaynak kayıt
  // `CANCELLED` olur ama iptalden ayrılmalıdır: cirosu kaybolmadı, hedefe geçti.
  // Rapor ve ekran bu alana bakıp "iptal" demez, "birleştirildi" der.
  mergedIntoId String?
  // İptal sebebi. Kalem iptalinde sebep ZORUNLUydu (`RestaurantTicketItem.reasonCode`)
  // ama dolu bir adisyonu tek tıkla iptal etmek sebepsizdi — ölçülemeyen kaçak,
  // olmayan kaçaktır. Kod listesi: lib/restoran/ticket-constants.ts.
  // BİRLEŞTİRMEDE doldurulmaz: orası iptal değil (bkz. `mergedIntoId`).
  cancelReasonCode String? @db.VarChar(30)
  cancelReason     String? @db.VarChar(255)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company    Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  table      RestaurantTable?        @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customer   Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  invoice    Invoice?                @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  discountEmployee Employee?         @relation("TicketDiscountEmployee", fields: [discountEmployeeId], references: [id], onDelete: SetNull)
  items      RestaurantTicketItem[]
  mergedInto RestaurantTicket?       @relation("TicketMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom RestaurantTicket[]      @relation("TicketMerge")
  reservation RestaurantReservation?

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([tableId])
  @@index([mergedIntoId])
  // Personel kartındaki "verdiği iskontolar" listesi bu indeksten okur.
  @@index([discountEmployeeId])
  @@map("restaurant_tickets")
}

// Rezervasyon — masanın GELECEKTEKİ dolusu.
//
// Adisyondan ayrı bir kayıttır: adisyon "şu an oturan"ı, rezervasyon "gelecek
// olan"ı anlatır. Aynı tabloda yaşasalardı her ciro sorgusu henüz gerçekleşmemiş
// hesapları elemek zorunda kalırdı ve gün sonu raporuna hayalet masa girerdi.
//
// `tableId` opsiyonel: "20:00, 6 kişi" rezervasyonu masası seçilmeden de alınır
// (masa gün içinde atanır). Masa silinirse rezervasyon masasız kalır, kaybolmaz.
model RestaurantReservation {
  id          String   @id @default(cuid())
  companyId   String
  tableId     String?
  guestName   String
  phone       String?
  guestCount  Int?
  // Rezervasyonun BAŞLANGICI. Süre `durationMin` ile tutulur; bitiş saati
  // saklanmaz, türetilir (iki alan ayrışırdı).
  reservedAt  DateTime
  durationMin Int      @default(90)
  note        String?  @db.Text
  // PENDING → bekliyor · SEATED → misafir oturdu · NOSHOW → gelmedi · CANCELLED
  status      String   @default("PENDING") @db.VarChar(10)
  // Misafir oturunca açılan adisyon. Rezervasyonun gerçekleştiğinin kanıtı ve
  // "rezervasyon ne kadar ciro getirdi" sorusunun tek bağı.
  ticketId    String?  @unique
  createdAt   DateTime @default(now())
  createdBy   String?
  updatedAt   DateTime @updatedAt

  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  table   RestaurantTable?  @relation(fields: [tableId], references: [id], onDelete: SetNull)
  ticket  RestaurantTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([companyId, reservedAt])
  @@index([tableId, reservedAt])
  @@map("restaurant_reservations")
}

// Adisyon kalemi. `unitPrice` NET'tir (KDV hariç) — fatura API'si net bekliyor,
// ekranda brüt gösterilir (kahveci ekranındaki `grossPrice` ile aynı kural).
// `description` ürün adının KOPYASIDIR: ürün sonradan yeniden adlandırılsa
// adisyon değişmez.
model RestaurantTicketItem {
  id          String   @id @default(cuid())
  ticketId    String
  productId   String?
  description String
  unit        String   @default("ADET")
  quantity    Decimal  @db.Decimal(14, 4)
  unitPrice   Decimal  @db.Decimal(15, 6)
  vatRate     Decimal  @default(20) @db.Decimal(5, 2)
  note        String? // "az şekerli"
  // Kalemin akıbeti. Üçünün stok/hesap davranışı FARKLI (docs/restoran/SATIS-EKRANI.md K2):
  //   NORMAL → hesaba girer, fişe girer, stok kapanışta düşer
  //   COMP   → ikram: hesapta 0,00 satır olarak GÖRÜNÜR, fişe girmez, stok DÜŞER
  //   WASTE  → zayi: hesapta görünmez, fişe girmez, stok DÜŞER
  //   VOID   → yanlış giriş: hiçbir yerde görünmez, stok düşmez (yalnız iz)
  // Silmek yerine işaretlemenin sebebi: ikram/zayi ölçülemezse kaçak da ölçülemez.
  status      String   @default("NORMAL") @db.VarChar(10)
  reasonCode  String?  @db.VarChar(30)
  reason      String?  @db.VarChar(255)
  // İkramı VEREN personel (İK kartı) — iskontodaki `discountEmployeeId` ile aynı
  // gerekçe: kasa ortak hesapla açıktır, "kim ikram etti" sorusunun cevabı oturumu
  // açan kişi değil o an masaya bakan garsondur. `createdBy` (oturum izi) ayrı durur.
  // İşaretleme ANINDA yazılır; kapanışta stok hareketine taşınır.
  compEmployeeId String?
  // Seçilen porsiyon/seçenekler: [{ groupName, optionName, priceDelta }] — ürün
  // adı gibi KOPYALANIR, sonradan seçenek tanımı değişse adisyon değişmez.
  // priceDelta KDV DAHİL saklanır (kullanıcı brüt düşünür); unitPrice'a net olarak yansır.
  options     Json?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  createdBy   String?

  ticket  RestaurantTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // SetNull: ürün kartı silinse de adisyon kalemi (adı ve fiyatı kopyalı) durur.
  product Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  compEmployee Employee?   @relation("TicketItemCompEmployee", fields: [compEmployeeId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([productId])
  @@index([compEmployeeId])
  @@map("restaurant_ticket_items")
}

// Ürün seçenekleri — "Boy", "Süt", "Ekstra" gibi bir SORU (grup) ve altındaki
// şıklar (option). Kahvecide boy sorunu "her boy ayrı ürün" ile çözülmüştü;
// seçenek bunun ölçeklenen hali (PLAN.md "Açık riskler" 2).
//
// Neden ürün kartında bir Json değil de iki tablo: şıkkın kendi fiyat farkı ve
// sırası var, menüde tek tek düzenleniyor; Json olsaydı her düzenleme tüm
// tanımı yeniden yazmak olurdu (Etiket Tasarımcısı'nda doğru olan desen burada
// yanlış — bkz. ASAMA2.md "Neden koordinat masanın satırında").
model ProductOptionGroup {
  id         String   @id @default(cuid())
  companyId  String
  productId  String
  name       String   @db.VarChar(80) // "Boy", "Süt", "Ekstra"
  // Zorunlu grupta seçim yapılmadan ürün sepete eklenemez (ör. Boy).
  isRequired Boolean  @default(false)
  // Çoklu seçim: "Ekstra" gibi gruplarda birden çok şık işaretlenebilir.
  isMulti    Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  options ProductOption[]

  @@index([companyId])
  @@index([productId])
  @@map("product_option_groups")
}

model ProductOption {
  id         String   @id @default(cuid())
  groupId    String
  name       String   @db.VarChar(80) // "Küçük", "Soya sütü"
  // Fiyat farkı KDV DAHİL (menüdeki fiyat gibi); 0 olabilir, negatif de olabilir.
  priceDelta Decimal  @default(0) @db.Decimal(12, 2)
  isDefault  Boolean  @default(false)
  order      Int      @default(0)

  // ---- Reçete etkisi (docs/restoran/SATIS-EKRANI.md K6) ----------------------
  // Seçenek yalnız FİYATI değil MALZEMEYİ de değiştirir: soya sütlü latte'de
  // stoktan inek sütü düşerse ikram/zayi düzeltmesi kadar sessiz bir maliyet
  // yalanı doğar. Üç mod, hepsi isteğe bağlı:
  //
  //   SWAP → reçetedeki `fromProduct` yerine `toProduct` düşer (miktar REÇETEDEN
  //          gelir; `toProduct` boşsa bileşen hiç düşmez: "şekersiz")
  //   ADD  → reçeteye ek olarak `toProduct` × `effectQuantity effectUnit` düşer
  //          ("ekstra shot"); eklenen ürünün kendi reçetesi de açılır
  //   —    → `recipeFactor` tek başına kullanılabilir: reçetenin TAMAMI ölçeklenir
  //          ("büyük boy" = 1.5). Reçetesi olmayan üründe etkisizdir.
  //
  // Etki, seçim anında adisyon kalemine KOPYALANIR (fiyat gibi): tanım sonradan
  // değişse açık adisyonun stok karşılığı değişmez.
  effectMode     String?  @db.VarChar(10) // SWAP | ADD | null
  fromProductId  String?
  toProductId    String?
  effectQuantity Decimal? @db.Decimal(14, 4)
  effectUnit     String?  @db.VarChar(20)
  recipeFactor   Decimal? @db.Decimal(6, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // SetNull: hammadde kartı silinse de seçenek (ve menü) ayakta kalır; eksik
  // taraflı etki genişletmede sessizce atlanır.
  fromProduct Product? @relation("OptionEffectFrom", fields: [fromProductId], references: [id], onDelete: SetNull)
  toProduct   Product? @relation("OptionEffectTo", fields: [toProductId], references: [id], onDelete: SetNull)

  @@index([groupId])
  @@map("product_options")
}

// Ürün etiketi tasarım şablonları (Etiket Tasarımcısı, /stok/etiket).
// design: versiyonlu element ağacı (lib/labels/types.ts LabelDesign) — mm tabanlı
// sayfa ayarları + öğeler (ürün alanı, metin, barkod, QR, şekil, görsel/emoji).
// Görsel/emoji öğeleri küçültülmüş PNG data-URI olarak design içinde saklanır;
// barkod/QR görüntüleri saklanmaz, her render'da üretilir. Şablon firma (şube)
// kapsamlıdır; başka şubeye aktarım "kopyala" API'siyle yapılır.
model LabelTemplate {
  id        String   @id @default(cuid())
  companyId String
  name      String
  slug      String   @default("")
  labelType String   @default("ROLL") // ROLL (rulo) | A4 (yaprak)
  design    Json
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, slug])
  @@index([companyId])
  @@map("label_templates")
}

model StockMovement {
  id          String   @id @default(cuid())
  companyId   String
  productId   String
  warehouseId String? // Depo ID (opsiyonel, geriye dönük uyumluluk için)
  type        String // IN, OUT, TRANSFER, ADJUSTMENT
  quantity    Decimal  @db.Decimal(14, 4) // 4 ondalık: reçete bileşen düşümü (bkz. Product.stockQuantity)
  unitPrice   Decimal? @db.Decimal(15, 6) // 6 ondalık: UBL e-Fatura birim fiyat hassasiyeti
  description String?  @db.Text
  reference   String? // Invoice ID, etc.
  createdAt   DateTime @default(now())
  createdBy   String?
  // Hareketten SORUMLU personel (İK kartı). Bugün yalnız ikram/zayi düzeltmesi
  // doldurur: tezgâh satışının adisyonu yoktur, dolayısıyla "bu ikramı kim verdi"
  // sorusunun tutunacağı tek kalıcı kayıt bu harekettir. `createdBy` oturum izidir
  // ve ayrı sorunun cevabıdır — ikisi aynı sütuna konsaydı iki kimlik kümesi tek
  // isimmiş gibi okunurdu (bkz. docs/restoran/SATIS-EKRANI.md K3.1).
  employeeId  String?

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  employee  Employee?  @relation("StockMovementEmployee", fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([warehouseId])
  @@index([productId])
  @@index([companyId, createdAt])
