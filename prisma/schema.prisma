  // Satır açıklaması: ürün adının ALTINA basılan serbest metin (ölçü, teslim
  // koşulu, marka/model detayı). description ürünle eşleşen addır ve faturaya
  // taşınan alan odur — açıklamayı oraya yazmak ürün adını kirletir.
  note           String?  @db.Text
  quantity       Decimal  @db.Decimal(10, 2)
  unitPrice      Decimal  @db.Decimal(15, 6) // 6 ondalık: UBL e-Fatura birim fiyat hassasiyeti
  discountRate   Decimal? @db.Decimal(5, 2)
  discountAmount Decimal? @db.Decimal(10, 2)
  vatRate        Decimal  @db.Decimal(5, 2)
  vatAmount      Decimal  @db.Decimal(10, 2)
  totalAmount    Decimal  @db.Decimal(10, 2)
  order          Int      @default(0)

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([productId])
  @@map("quote_items")
}

model Order {
